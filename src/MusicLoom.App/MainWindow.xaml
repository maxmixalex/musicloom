                   <Viewbox x:Name="LibrarySortDescendingIcon" Width="16" Height="16" Visibility="Collapsed"><PathIcon Width="20" Height="20" Data="M4.00012 2C3.72398 2 3.50012 2.22386 3.50012 2.5C3.50012 2.77614 3.72398 3 4.00012 3H7.06586L3.5841 8.22265C3.48181 8.37608 3.47228 8.57335 3.55929 8.73593C3.6463 8.89851 3.81573 9 4.00012 9H8.00012C8.27627 9 8.50012 8.77614 8.50012 8.5C8.50012 8.22386 8.27627 8 8.00012 8H4.93438L8.41615 2.77735C8.51843 2.62392 8.52797 2.42665 8.44096 2.26407C8.35395 2.10149 8.18452 2 8.00012 2H4.00012ZM6.46551 10.3172C6.39034 10.1258 6.20571 10 6.00013 10C5.79456 10 5.60993 10.1258 5.53476 10.3172L2.78476 17.3172C2.68379 17.5742 2.81029 17.8644 3.06731 17.9654C3.32433 18.0663 3.61454 17.9398 3.71551 17.6828L4.37662 16H7.62365L8.28476 17.6828C8.38573 17.9398 8.67594 18.0663 8.93296 17.9654C9.18998 17.8644 9.31648 17.5742 9.21551 17.3172L6.46551 10.3172ZM6.00013 11.8674L7.23079 15H4.76948L6.00013 11.8674ZM14.5 2C14.7761 2 15 2.22386 15 2.5V16.2929L17.1464 14.1464C17.3417 13.9512 17.6583 13.9512 17.8536 14.1464C18.0488 14.3417 18.0488 14.6583 17.8536 14.8536L14.8536 17.8536C14.6583 18.0488 14.3417 18.0488 14.1464 17.8536L11.1464 14.8536C10.9512 14.6583 10.9512 14.3417 11.1464 14.1464C11.3417 13.9512 11.6583 13.9512 11.8536 14.1464L14 16.2929V2.5C14 2.22386 14.2239 2 14.5 2Z"/></Viewbox>
                </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel Width="225" Spacing="9">
                      <TextBlock x:Name="LibrarySortPanelHeading"
                                 FontSize="16" FontWeight="SemiBold"
                                 Text="Sort songs"/>
                      <ComboBox x:Name="LibrarySortBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibrarySortBox_SelectionChanged">
                        <ComboBoxItem x:Name="SortTitleItem" Content="Sort by title" Tag="title"/>
                        <ComboBoxItem x:Name="SortAlbumItem" Content="Sort by album" Tag="album"/>
                        <ComboBoxItem x:Name="SortArtistItem" Content="Sort by artist" Tag="artist"/>
                      </ComboBox>
                      <ComboBox x:Name="LibrarySortDirectionBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibrarySortDirectionBox_SelectionChanged">
                        <ComboBoxItem x:Name="LibrarySortAscendingItem" Tag="asc">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16"><PathIcon Width="20" Height="20" Data="M6.46551 2.31717C6.39034 2.12583 6.20571 2 6.00013 2C5.79456 2 5.60993 2.12583 5.53476 2.31717L2.78476 9.31717C2.68379 9.57419 2.81029 9.8644 3.06731 9.96538C3.32433 10.0663 3.61454 9.93985 3.71551 9.68283L4.37662 8H7.62365L8.28476 9.68283C8.38573 9.93985 8.67594 10.0663 8.93296 9.96538C9.18998 9.8644 9.31648 9.57419 9.21551 9.31717L6.46551 2.31717ZM6.00013 3.86742L7.23079 7H4.76948L6.00013 3.86742ZM4.00012 11C3.72398 11 3.50012 11.2239 3.50012 11.5C3.50012 11.7761 3.72398 12 4.00012 12H7.06586L3.5841 17.2227C3.48181 17.3761 3.47228 17.5734 3.55929 17.7359C3.6463 17.8985 3.81573 18 4.00012 18H8.00012C8.27627 18 8.50012 17.7761 8.50012 17.5C8.50012 17.2239 8.27627 17 8.00012 17H4.93438L8.41615 11.7774C8.51843 11.6239 8.52797 11.4267 8.44096 11.2641C8.35395 11.1015 8.18452 11 8.00012 11H4.00012ZM14.5 2C14.7761 2 15 2.22386 15 2.5V16.2929L17.1464 14.1464C17.3417 13.9512 17.6583 13.9512 17.8536 14.1464C18.0488 14.3417 18.0488 14.6583 17.8536 14.8536L14.8536 17.8536C14.6583 18.0488 14.3417 18.0488 14.1464 17.8536L11.1464 14.8536C10.9512 14.6583 10.9512 14.3417 11.1464 14.1464C11.3417 13.9512 11.6583 13.9512 11.8536 14.1464L14 16.2929V2.5C14 2.22386 14.2239 2 14.5 2Z"/></Viewbox>
                            <TextBlock x:Name="LibrarySortAscendingLabel" Text="Ascending"/>
                          </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="LibrarySortDescendingItem" Tag="desc">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Viewbox Width="16" Height="16"><PathIcon Width="20" Height="20" Data="M4.00012 2C3.72398 2 3.50012 2.22386 3.50012 2.5C3.50012 2.77614 3.72398 3 4.00012 3H7.06586L3.5841 8.22265C3.48181 8.37608 3.47228 8.57335 3.55929 8.73593C3.6463 8.89851 3.81573 9 4.00012 9H8.00012C8.27627 9 8.50012 8.77614 8.50012 8.5C8.50012 8.22386 8.27627 8 8.00012 8H4.93438L8.41615 2.77735C8.51843 2.62392 8.52797 2.42665 8.44096 2.26407C8.35395 2.10149 8.18452 2 8.00012 2H4.00012ZM6.46551 10.3172C6.39034 10.1258 6.20571 10 6.00013 10C5.79456 10 5.60993 10.1258 5.53476 10.3172L2.78476 17.3172C2.68379 17.5742 2.81029 17.8644 3.06731 17.9654C3.32433 18.0663 3.61454 17.9398 3.71551 17.6828L4.37662 16H7.62365L8.28476 17.6828C8.38573 17.9398 8.67594 18.0663 8.93296 17.9654C9.18998 17.8644 9.31648 17.5742 9.21551 17.3172L6.46551 10.3172ZM6.00013 11.8674L7.23079 15H4.76948L6.00013 11.8674ZM14.5 2C14.7761 2 15 2.22386 15 2.5V16.2929L17.1464 14.1464C17.3417 13.9512 17.6583 13.9512 17.8536 14.1464C18.0488 14.3417 18.0488 14.6583 17.8536 14.8536L14.8536 17.8536C14.6583 18.0488 14.3417 18.0488 14.1464 17.8536L11.1464 14.8536C10.9512 14.6583 10.9512 14.3417 11.1464 14.1464C11.3417 13.9512 11.6583 13.9512 11.8536 14.1464L14 16.2929V2.5C14 2.22386 14.2239 2 14.5 2Z"/></Viewbox>
                            <TextBlock x:Name="LibrarySortDescendingLabel" Text="Descending"/>
                          </StackPanel>
                        </ComboBoxItem>
                      </ComboBox>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>

            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        Spacing="12" VerticalAlignment="Center"
                        HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon x:Name="PendingSummaryIcon" Glyph="&#xE823;" FontSize="12"
                          Foreground="#CA7400" ToolTipService.ToolTip="Pending"/>
                <TextBlock x:Name="PendingCountText" Text="0" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon x:Name="WarningSummaryIcon" Glyph="&#xE7BA;" FontSize="12"
                          Foreground="#CA7400" ToolTipService.ToolTip="Warnings"/>
                <TextBlock x:Name="WarningCountText" Text="0" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <FontIcon x:Name="ErrorSummaryIcon" Glyph="&#xEA39;" FontSize="12"
                          Foreground="#C42B1C" ToolTipService.ToolTip="Errors"/>
                <TextBlock x:Name="ErrorCountText" Text="0" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="LibraryVisibleCountText" Text="0 tracks"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="2">
            <TextBlock x:Name="LibraryActiveFilterSummary"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="Collapsed" Margin="0,0,0,8"/>
          </Grid>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="LibraryListColumn" Width="*" MinWidth="360" />
              <ColumnDefinition x:Name="LibrarySplitterColumn" Width="0" />
              <ColumnDefinition x:Name="LibraryDetailColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="LibraryProgressPanel"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Margin="10,10,10,4"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="OperationStatusText"
                        Text="Ready."
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar
                        x:Name="OperationProgressBar"
                        Height="3"
                        Minimum="0"
                        Maximum="100" />
                  </StackPanel>
                </Border>

                <ListView
                    x:Name="LibraryList"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    SelectionMode="Extended"
                    SelectionChanged="LibraryList_SelectionChanged"
                    DoubleTapped="LibraryList_DoubleTapped"
                    RightTapped="LibraryList_RightTapped"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.ContextFlyout>
                    <MenuFlyout x:Name="TrackContextMenu" Opening="TrackContextMenu_Opening">
                      <MenuFlyoutItem x:Name="ContextPlayItem" Text="Play" Click="ContextPlayItem_Click">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator x:Name="ContextFileSeparator" />
                      <MenuFlyoutItem x:Name="ContextOpenSourceItem" Text="Open source folder" Click="ContextOpenSourceItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextOpenDestinationItem" Text="Open destination folder" Click="ContextOpenDestinationItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator x:Name="ContextCopySeparator" />
                      <MenuFlyoutItem x:Name="ContextCopySourceItem" Text="Copy source path" Click="ContextCopySourceItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextCopyDestinationItem" Text="Copy destination path" Click="ContextCopyDestinationItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator x:Name="ContextMatchSeparator" />
                      <MenuFlyoutItem x:Name="ContextFindMatchItem" Text="Find NetEase match…" Click="ContextFindMatchItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE721;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextConfirmMatchItem" Text="Confirm NetEase match" Visibility="Collapsed" Click="ContextConfirmMatchItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextClearMatchItem" Text="Clear NetEase match"
                                      Visibility="Collapsed" Click="ContextClearMatchItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextConfirmSelectedMatchesItem" Text="Confirm selected matches"
                                      Visibility="Collapsed" Click="ContextConfirmSelectedMatchesItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextClearSelectedMatchesItem" Text="Clear selected matches"
                                      Visibility="Collapsed" Click="ContextClearSelectedMatchesItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem x:Name="ContextUpdateSelectedLyricsItem" Text="Update selected lyrics"
                                      Visibility="Collapsed" Click="ContextUpdateSelectedLyricsItem_Click">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Refresh" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </ListView.ContextFlyout>

                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0,1" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListViewItem">
                            <primitives:ListViewItemPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                SelectionIndicatorVisualEnabled="True"
                                SelectionIndicatorMode="Inline"
                                SelectionIndicatorBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                SelectionIndicatorPointerOverBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                SelectionIndicatorPressedBrush="{ThemeResource AccentFillColorTertiaryBrush}" />
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListView.ItemContainerStyle>

                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="60" Padding="10,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <!-- Draw the recording's real amplitude envelope
                             underneath the entire row's content. -->
                        <local:PlayingWaveform Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Margin="-10,-7"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               IsActive="{Binding IsPlaying}"
                                               Samples="{Binding WaveformSamples}" />
                        <Border Width="44" Height="44" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                          <Grid>
                            <Image Source="{Binding Artwork}" Stretch="Uniform" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     TextWrapping="{Binding RowTextWrapping}"
                                     TextTrimming="{Binding RowTextTrimming}"
                                     MaxLines="{Binding RowMaxLines}"
                                     ToolTipService.ToolTip="{Binding TitleToolTip}" />
                          <TextBlock Text="{Binding ArtistAlbum}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     TextWrapping="{Binding RowTextWrapping}"
                                     TextTrimming="{Binding RowTextTrimming}"
                                     MaxLines="{Binding RowMaxLines}"
                                     ToolTipService.ToolTip="{Binding SubtitleToolTip}" />
                        </StackPanel>

                        <Grid Grid.Column="2" Width="26" Height="26"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              ToolTipService.ToolTip="{Binding StatusText}">
                          <FontIcon Glyph="{Binding StatusGlyph}" FontSize="13"
                                    Foreground="{Binding StatusBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="LibraryEmptyPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="340"
                    Spacing="10">
                  <TextBlock x:Name="LibraryEmptyTitleText" Text="" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
                  <TextBlock
                      x:Name="LibraryEmptyBodyText"
                      Text=""
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <Button x:Name="OpenSettingsButton" Content="Open settings" Click="OpenSettingsButton_Click" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- A compositor-throttled Thumb replaces GridSplitter's
                 full synchronous layout per input pixel. Every pointer
                 delta contributes to a smooth frame; never round to 3 px. -->
            <primitives:Thumb x:Name="LibrarySplitter"
                              Grid.Column="1"
                              Width="12"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              Loaded="LibrarySplitter_Loaded"
                              DragStarted="LibrarySplitter_DragStarted"
                              DragDelta="LibrarySplitter_DragDelta"
                              DragCompleted="LibrarySplitter_DragCompleted"
                              Visibility="Collapsed">
              <primitives:Thumb.Template>
                <ControlTemplate TargetType="primitives:Thumb">
                  <!-- Transparent 12px grab area: no permanent divider. -->
                  <Grid Background="Transparent" />
                </ControlTemplate>
              </primitives:Thumb.Template>
            </primitives:Thumb>

            <Border
                x:Name="DetailPane"
                Grid.Column="2"
                Visibility="Collapsed"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <Grid Padding="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="18">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                  </Grid.ColumnDefinitions>

                  <Button
                      x:Name="CoverButton"
                      Grid.Column="0"
                      Width="132"
                      Height="132"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      RenderTransformOrigin="0.5,0.5"
                      Click="CoverButton_Click"
                      PointerEntered="CoverButton_PointerEntered"
                      PointerExited="CoverButton_PointerExited"
                      ToolTipService.ToolTip="Open artwork">
                    <Button.Resources>
                      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </Button.Resources>
                    <Button.RenderTransform>
                      <ScaleTransform x:Name="CoverScaleTransform" ScaleX="1" ScaleY="1" />
                    </Button.RenderTransform>
                    <Border
                        Width="132"
                        Height="132"
                        CornerRadius="9"
                        Background="Transparent">
                      <Grid>
                        <Image
                            x:Name="CoverImage"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="CoverPlaceholderText"
                            Text="No artwork"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </Grid>
                    </Border>
                  </Button>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                    <ScrollViewer
                        x:Name="TrackTitleViewport"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False">
                      <TextBlock
                          x:Name="TrackTitleText"
                          Text=""
                          FontSize="26"
                          FontWeight="SemiBold"
                          TextWrapping="NoWrap"
                          HorizontalAlignment="Left">
                        <TextBlock.RenderTransform>
                          <TranslateTransform x:Name="TrackTitleTranslateTransform" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="TrackArtistViewport"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False">
                      <TextBlock
                          x:Name="TrackArtistText"
                          Text=""
                          FontSize="16"
                          TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                          <TranslateTransform x:Name="TrackArtistTranslateTransform" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="TrackAlbumViewport"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False">
                      <TextBlock
                          x:Name="TrackAlbumText"
                          Text=""
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="NoWrap"
                          HorizontalAlignment="Left">
                        <TextBlock.RenderTransform>
                          <TranslateTransform x:Name="TrackAlbumTranslateTransform" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                      <FontIcon x:Name="TrackStatusIcon" Glyph="&#xE823;" FontSize="13" />
                      <TextBlock x:Name="TrackStatusText" Text="" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Spacing="7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                  <Button
                      x:Name="DetailPlayButton"
                      Width="48"
                      Height="48"
                      Padding="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Click="DetailPlayButton_Click"
                      ToolTipService.ToolTip="Play track">
                    <SymbolIcon x:Name="DetailPlayIcon" Symbol="Play" />
                  </Button>
                  <TextBlock x:Name="DetailDurationText" Text="—"
                             HorizontalAlignment="Center" FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </StackPanel>

                  <Button
                      x:Name="CloseDetailButton"
                      Grid.Column="2"
                      Width="32"
                      Height="32"
                      Margin="0,-10,-10,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="CloseDetailButton_Click"
                      ToolTipService.ToolTip="Close details">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                  </Button>
                </Grid>

                <TabView
                    x:Name="DetailTabs"
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    IsAddTabButtonVisible="False"
                    CanDragTabs="False"
                    CanReorderTabs="False"
                    TabWidthMode="SizeToContent">
                  <TabViewItem x:Name="LyricsTab" Header="Lyrics" IsClosable="False">
                    <Grid Padding="2,12,2,2">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>

                      <Grid Margin="2,0,2,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer
                            x:Name="LyricsSourceViewport"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            VerticalScrollMode="Disabled"
                            ZoomMode="Disabled"
                            IsTabStop="False">
                          <TextBlock
                              x:Name="LyricsSourceText"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                              <TranslateTransform x:Name="LyricsSourceTranslateTransform" />
                            </TextBlock.RenderTransform>
                          </TextBlock>
                        </ScrollViewer>
                        <ComboBox
                            x:Name="LyricsModeBox"
                            Grid.Column="0"
                            Width="126"
                            HorizontalAlignment="Left"
                            SelectionChanged="LyricsModeBox_SelectionChanged">
                          <ComboBoxItem x:Name="LyricsOriginalOnlyItem" Content="Original only" Tag="originalOnly" />
                          <ComboBoxItem x:Name="LyricsPreferTranslationItem" Content="Prefer translation" Tag="preferTranslation" />
                          <ComboBoxItem x:Name="LyricsPreferOriginalItem" Content="Prefer original" Tag="preferOriginal" />
                        </ComboBox>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right" Spacing="4">
                          <Button x:Name="ClearLyricsButton" Padding="6,4"
                                  Click="ClearLyricsButton_Click"
                                  ToolTipService.ToolTip="Clear lyrics">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <FontIcon Glyph="&#xE74D;" FontSize="14" />
                              <TextBlock x:Name="ClearLyricsButtonText" Text="Clear" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="AdjustLyricsButton" Padding="6,4"
                                  Click="AdjustLyricsButton_Click"
                                  ToolTipService.ToolTip="Set lyric offset">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <FontIcon Glyph="&#xE823;" FontSize="14" />
                              <TextBlock x:Name="AdjustLyricsButtonText" Text="Adjust" />
                            </StackPanel>
                          </Button>
                          <Button x:Name="EditLyricsButton" Padding="6,4"
                                  Click="EditLyricsButton_Click"
                                  ToolTipService.ToolTip="Edit lyrics">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <FontIcon Glyph="&#xE70F;" FontSize="14" />
                              <TextBlock x:Name="EditLyricsButtonText" Text="Edit" />
                            </StackPanel>
                          </Button>
                          <DropDownButton
                            x:Name="CopyAllLyricsButton"
                            Padding="6,4"
                            ToolTipService.ToolTip="Copy full lyrics">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock x:Name="CopyAllLyricsButtonText" Text="Copy all" />
                          </StackPanel>
                          <DropDownButton.Flyout>
                            <MenuFlyout>
                              <MenuFlyoutItem
                                  x:Name="CopyAllLyricsTextItem"
                                  Text="Copy as text"
                                  Click="CopyAllLyricsTextItem_Click" />
                              <MenuFlyoutItem
                                  x:Name="CopyAllLyricsLrcItem"
                                  Text="Copy as LRC"
                                  Click="CopyAllLyricsLrcItem_Click" />
                            </MenuFlyout>
                          </DropDownButton.Flyout>
                          </DropDownButton>
                        </StackPanel>
                      </Grid>

                      <ListView
                          x:Name="LyricsList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          DoubleTapped="LyricsList_DoubleTapped"
                          RightTapped="LyricsList_RightTapped"
                          HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                  <primitives:ListViewItemPresenter
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      SelectionIndicatorVisualEnabled="True"
                                      SelectionIndicatorMode="Inline"
                                      SelectionIndicatorBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                      SelectionIndicatorPointerOverBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                                      SelectionIndicatorPressedBrush="{ThemeResource AccentFillColorTertiaryBrush}" />
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Grid Padding="8,7" ColumnSpacing="8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.ContextFlyout>
                                <MenuFlyout Opening="LyricLineMenu_Opening">
                                  <MenuFlyoutSubItem
                                      x:Name="CopyLyricLineItem"
                                      Text="Copy line">
                                    <MenuFlyoutSubItem.Icon>
                                      <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem
                                        x:Name="CopyLyricLineTextItem"
                                        Text="Copy as text"
                                        Tag="{Binding}"
                                        Click="CopyLyricLineTextItem_Click" />
                                    <MenuFlyoutItem
                                        x:Name="CopyLyricLineLrcItem"
                                        Text="Copy as LRC"
                                        Tag="{Binding}"
                                        Click="CopyLyricLineLrcItem_Click" />
                                  </MenuFlyoutSubItem>
                                  <MenuFlyoutSeparator />
                                  <MenuFlyoutItem
                                      x:Name="SeekLyricLineItem"
                                      Text="Play from here"
                                      Tag="{Binding}"
                                      Click="SeekLyricLineItem_Click">
                                    <MenuFlyoutItem.Icon>
                                      <SymbolIcon Symbol="Play" />
                                    </MenuFlyoutItem.Icon>
                                  </MenuFlyoutItem>
                                </MenuFlyout>
                              </Grid.ContextFlyout>
                              <TextBlock
                                  Text="{Binding TimestampText}"
                                  Margin="0,3,0,0"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  VerticalAlignment="Top" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock x:Name="PrimaryLyricText"
                                    local:KaraokeLyricText.Line="{Binding}"
                                    Visibility="{Binding PrimaryPlainVisibility}"
                                    FontSize="{Binding PrimaryFontSize}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    LineHeight="23" TextWrapping="WrapWholeWords"
                                    IsTextSelectionEnabled="False" />
                                <local:RubyLyricView
                                    Line="{Binding}"
                                    Visibility="{Binding PrimaryRubyVisibility}"
                                    FontSize="{Binding PrimaryFontSize}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="SecondaryLyricText"
                                    local:KaraokeLyricText.Line="{Binding}"
                                    local:KaraokeLyricText.IsSecondary="True"
                                    Visibility="{Binding SecondaryPlainVisibility}"
                                    FontSize="{Binding SecondaryFontSize}"
                                    LineHeight="20"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="WrapWholeWords"
                                    IsTextSelectionEnabled="False" />
                                <local:RubyLyricView
                                    Line="{Binding}" IsSecondary="True"
                                    Visibility="{Binding SecondaryRubyVisibility}"
                                    FontSize="{Binding SecondaryFontSize}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>
                    </Grid>
                  </TabViewItem>

                   <TabViewItem x:Name="MatchTab" Header="NetEase match" IsClosable="False">
                    <local:ProviderMatchTabView x:Name="NeteaseMatchPanel" />
                  </TabViewItem>

                  <!-- Three independent providers, deliberately parallel
                       rather than QQ/KuGou actions inside the NetEase tab. -->
                  <TabViewItem x:Name="QqMatchTab" Header="QQ Music match" IsClosable="False">
                    <local:ProviderMatchTabView x:Name="QqMatchPanel" />
                  </TabViewItem>
                  <TabViewItem x:Name="KugouMatchTab" Header="KuGou Music match" IsClosable="False">
                    <local:ProviderMatchTabView x:Name="KugouMatchPanel" />
                  </TabViewItem>
                  <TabViewItem x:Name="MiguMatchTab" Header="Migu Music match" IsClosable="False">
                    <local:ProviderMatchTabView x:Name="MiguMatchPanel" />
                  </TabViewItem>
                  <TabViewItem x:Name="SyncTab" Header="Sync" IsClosable="False">
                    <ScrollViewer Padding="4,14,4,4">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <FontIcon
                              x:Name="TrackSyncTabStatusIcon"
                              Glyph="&#xE823;"
                              FontSize="16"
                              VerticalAlignment="Center" />
                          <TextBlock
                              x:Name="TrackSyncStateText"
                              Text="No sync information."
                              FontSize="18"
                              FontWeight="SemiBold"
                              TextWrapping="Wrap"
                              VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TrackSyncTimeText"
                            Text=""
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TrackSyncLogHeadingText"
                            Text="Latest sync log"
                            Margin="0,8,0,0"
                            FontWeight="SemiBold" />
                        <TextBox
                            x:Name="TrackSyncLogText"
                            MinHeight="150"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Cascadia Mono"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                      </StackPanel>
                    </ScrollViewer>
                  </TabViewItem>

                  <TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
                    <ScrollViewer Padding="4,14,4,4">
                      <Grid ColumnSpacing="18" RowSpacing="11">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="140" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SourcePathHeadingText" Text="Source" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackSourcePathText" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="DestinationPathHeadingText" Grid.Row="1" Text="Destination" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackDestinationPathText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="FormatHeadingText" Grid.Row="2" Text="Format" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackFormatText" Grid.Row="2" Grid.Column="1" />

                        <TextBlock x:Name="DurationHeadingText" Grid.Row="3" Text="Duration" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackDurationText" Grid.Row="3" Grid.Column="1" />

                        <TextBlock x:Name="BitrateHeadingText" Grid.Row="4" Text="Bitrate" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackBitrateText" Grid.Row="4" Grid.Column="1" />

                        <TextBlock x:Name="SampleRateHeadingText" Grid.Row="5" Text="Sample rate" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackSampleRateText" Grid.Row="5" Grid.Column="1" />

                        <TextBlock x:Name="BitDepthHeadingText" Grid.Row="6" Text="Bit depth" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackBitDepthText" Grid.Row="6" Grid.Column="1" />

                        <TextBlock x:Name="ChannelsHeadingText" Grid.Row="7" Text="Channels" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackChannelsText" Grid.Row="7" Grid.Column="1" />

                        <TextBlock x:Name="BitrateModeHeadingText" Grid.Row="8" Text="Bitrate mode" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackBitrateModeText" Grid.Row="8" Grid.Column="1" />

                        <TextBlock x:Name="SizeHeadingText" Grid.Row="9" Text="Source size" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackSizeText" Grid.Row="9" Grid.Column="1" />

                        <TextBlock x:Name="ModifiedHeadingText" Grid.Row="10" Text="Modified" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackModifiedText" Grid.Row="10" Grid.Column="1" />

                        <TextBlock x:Name="CreatedHeadingText" Grid.Row="11" Text="Created" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackCreatedText" Grid.Row="11" Grid.Column="1" />

                        <TextBlock x:Name="DestinationSizeHeadingText" Grid.Row="12" Text="Destination size" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackDestinationSizeText" Grid.Row="12" Grid.Column="1" />

                        <TextBlock x:Name="DestinationModifiedHeadingText" Grid.Row="13" Text="Destination modified" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrackDestinationModifiedText" Grid.Row="13" Grid.Column="1" />
                      </Grid>
                    </ScrollViewer>
                  </TabViewItem>
                </TabView>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Playlists -->
        <Grid x:Name="PlaylistsPage" Visibility="Collapsed" Padding="28,22,28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Spacing="3">
            <TextBlock x:Name="PlaylistsTitleText" Text="Playlists" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="PlaylistsSubtitleText" Text="Browse your MusicBee playlists." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300" MinWidth="240" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <ListView
                  x:Name="PlaylistsList"
                  SelectionChanged="PlaylistsList_SelectionChanged"
                  HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <Grid Padding="14,10" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{Binding Name}"
                            FontWeight="SemiBold"
                            TextWrapping="{Binding NameTextWrapping}"
                            TextTrimming="{Binding NameTextTrimming}"
                            MaxLines="{Binding NameMaxLines}"
                            ToolTipService.ToolTip="{Binding NameToolTip}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding CountText}"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon
                            Grid.Column="2"
                            Glyph="{Binding StatusGlyph}"
                            Foreground="{Binding StatusBrush}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                      </Grid>
                      <Border
                          Height="1"
                          Margin="14,0,14,0"
                          Background="{ThemeResource CardStrokeColorDefaultBrush}"
                          Visibility="{Binding SeparatorVisibility}" />
                    </StackPanel>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>

            <Border
                Grid.Column="1"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <Grid Padding="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <ScrollViewer
                        x:Name="PlaylistTitleViewport"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False">
                      <TextBlock
                          x:Name="PlaylistTitleText"
                          Text="Select a playlist"
                          FontSize="22"
                          FontWeight="SemiBold"
                          TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                          <TranslateTransform x:Name="PlaylistTitleTranslateTransform" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                    </ScrollViewer>
                    <ScrollViewer
                        x:Name="PlaylistMetaViewport"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled"
                        IsTabStop="False">
                      <TextBlock
                          x:Name="PlaylistMetaText"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                          <TranslateTransform x:Name="PlaylistMetaTranslateTransform" />
                        </TextBlock.RenderTransform>
                      </TextBlock>
                    </ScrollViewer>
                  </StackPanel>
                  <Button
                      x:Name="PlaylistHeaderPlayButton"
                      Grid.Column="1"
                      Width="40"
                      Height="40"
                      Padding="0"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Right"
                      Click="PlaylistHeaderPlayButton_Click"
                      ToolTipService.ToolTip="Play playlist">
                    <SymbolIcon Symbol="Play" />
                  </Button>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,8" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="105" />
                  </Grid.ColumnDefinitions>
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <SymbolIcon Symbol="Find" VerticalAlignment="Center" Margin="4,0,0,0" />
                    <TextBox
                        x:Name="PlaylistSearchBox"
                        Grid.Column="1"
                        PlaceholderText="Search this playlist"
                        TextChanged="PlaylistSearchBox_TextChanged" />
                  </Grid>
                  <ComboBox
                      x:Name="PlaylistSortBox"
                      Grid.Column="1"
                      SelectionChanged="PlaylistSortBox_SelectionChanged">
                    <ComboBoxItem x:Name="PlaylistSortTitleItem" Content="Sort by title" Tag="title" />
                    <ComboBoxItem x:Name="PlaylistSortAlbumItem" Content="Sort by album" Tag="album" />
                    <ComboBoxItem x:Name="PlaylistSortArtistItem" Content="Sort by artist" Tag="artist" />
                  </ComboBox>
                  <ComboBox
                      x:Name="PlaylistSortDirectionBox"
                      Grid.Column="2"
                      SelectionChanged="PlaylistSortDirectionBox_SelectionChanged">
                    <ComboBoxItem x:Name="PlaylistSortAscendingItem" Content="Ascending" Tag="asc" />
                    <ComboBoxItem x:Name="PlaylistSortDescendingItem" Content="Descending" Tag="desc" />
                  </ComboBox>
                </Grid>

                <Border
                    x:Name="PlaylistProgressPanel"
                    Grid.Row="2"
                    Visibility="Collapsed"
                    Margin="0,0,0,8"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock
                          x:Name="PlaylistOperationStatusText"
                          Text="Ready."
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <Button
                          x:Name="PlaylistCancelButton"
                          Grid.Column="1"
                          Padding="8,3"
                          Click="CancelButton_Click">
                        <TextBlock x:Name="PlaylistCancelButtonText" Text="Cancel" />
                      </Button>
                    </Grid>
                    <ProgressBar
                        x:Name="PlaylistOperationProgressBar"
                        Height="3"
                        Minimum="0"
                        Maximum="100" />
                  </StackPanel>
                </Border>

                <ListView
                    x:Name="PlaylistTracksList"
                    Grid.Row="3"
                    DoubleTapped="PlaylistTracksList_DoubleTapped"
                    RightTapped="PlaylistTracksList_RightTapped"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.ContextFlyout>
                    <MenuFlyout>
                      <MenuFlyoutItem
                          x:Name="PlaylistPlayItem"
                          Text="Play"
                          Click="PlaylistPlayItem_Click">
                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Play" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem
                          x:Name="PlaylistShowInLibraryItem"
                          Text="Show in library"
                          Click="PlaylistShowInLibraryItem_Click">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </ListView.ContextFlyout>
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0,1" />
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="60" Padding="10,7" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <!-- Draw the recording's real amplitude envelope
                             underneath the entire row's content. -->
                        <local:PlayingWaveform Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Margin="-10,-7"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               IsActive="{Binding IsPlaying}"
                                               Samples="{Binding WaveformSamples}" />
                        <Border Width="44" Height="44" CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                          <Grid>
                            <Image Source="{Binding Artwork}" Stretch="Uniform" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                     TextWrapping="{Binding RowTextWrapping}"
                                     TextTrimming="{Binding RowTextTrimming}"
                                     MaxLines="{Binding RowMaxLines}"
                                     ToolTipService.ToolTip="{Binding TitleToolTip}" />
                          <TextBlock Text="{Binding ArtistAlbum}" FontSize="12"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     TextWrapping="{Binding RowTextWrapping}"
                                     TextTrimming="{Binding RowTextTrimming}"
                                     MaxLines="{Binding RowMaxLines}"
                                     ToolTipService.ToolTip="{Binding SubtitleToolTip}" />
                        </StackPanel>

                        <Grid Grid.Column="2" Width="26" Height="26"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              ToolTipService.ToolTip="{Binding StatusText}">
                          <FontIcon Glyph="{Binding StatusGlyph}" FontSize="13"
                                    Foreground="{Binding StatusBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
          <Grid Padding="28,22,28,32">
            <StackPanel Spacing="20">
              <StackPanel Spacing="3">
                <TextBlock x:Name="SettingsTitleText" Text="Settings" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="SettingsSubtitleText" Text="Changes are saved automatically." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock x:Name="LibrarySettingsHeadingText" Text="Library" FontSize="18" FontWeight="SemiBold" />

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="SourceLibrarySettingTitle" Text="Source library" FontWeight="SemiBold" />
                      <TextBlock x:Name="SourceLibrarySettingDescription" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="SourcePathBox" Grid.Column="1" TextChanged="SettingsControl_Changed" />
                    <Button x:Name="BrowseSourceButton" Grid.Column="2" Content="Browse" Click="BrowseSourceButton_Click" />
                    <Button x:Name="OpenSourceButton" Grid.Column="3" Content="Open" Click="OpenSourceButton_Click" />
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="DestinationLibrarySettingTitle" Text="Destination library" FontWeight="SemiBold" />
                      <TextBlock x:Name="DestinationLibrarySettingDescription" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="DestinationPathBox" Grid.Column="1" TextChanged="SettingsControl_Changed" />
                    <Button x:Name="BrowseDestinationButton" Grid.Column="2" Content="Browse" Click="BrowseDestinationButton_Click" />
                    <Button x:Name="OpenDestinationSettingButton" Grid.Column="3" Content="Open" Click="OpenDestinationSettingButton_Click" />
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="PlaylistFolderSettingTitle" Text="MusicBee playlist folder" FontWeight="SemiBold" />
                      <TextBlock x:Name="PlaylistFolderSettingDescription" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="PlaylistSourcePathBox" Grid.Column="1" TextChanged="SettingsControl_Changed" />
                    <Button x:Name="BrowsePlaylistButton" Grid.Column="2" Content="Browse" Click="BrowsePlaylistButton_Click" />
                    <Button x:Name="OpenPlaylistButton" Grid.Column="3" Content="Open" Click="OpenPlaylistButton_Click" />
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PlaylistBaseSettingTitle"
                        Text="Playlist path on phone"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <TextBox
                        x:Name="PlaylistBaseBox"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        TextChanged="SettingsControl_Changed" />
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="AutoScanSettingTitle" Text="Scan on startup" FontWeight="SemiBold" />
                      <TextBlock x:Name="AutoScanSettingDescription" Text="Refresh source and destination libraries once at startup." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="280" HorizontalAlignment="Right">
                      <ToggleSwitch x:Name="AutoScanOnStartupToggle" HorizontalAlignment="Right" Toggled="SettingsControl_Changed" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Padding="20,16" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                      <TextBlock
                          x:Name="DatabaseSettingTitle"
                          Text="LOCAL DATABASE"
                          FontSize="12"
                          CharacterSpacing="45"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock
                          x:Name="DatabaseSizeText"
                          Text="0 B"
                          FontSize="22"
                          FontWeight="SemiBold" />
                      <TextBlock
                          x:Name="DatabasePathText"
                          Text=""
                          FontSize="12"
                          TextWrapping="Wrap"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="ClearDatabaseButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        BorderThickness="0"
                        Content="Clear database"
                        Click="ClearDatabaseButton_Click">
                      <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#A4261E" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8C1D18" />
                        <SolidColorBrush x:Key="ButtonForeground" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                      </Button.Resources>
                    </Button>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock x:Name="LyricsSettingsHeadingText" Text="Lyrics" FontSize="18" FontWeight="SemiBold" />

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="OverwriteLyricsSettingTitle" Text="Overwrite existing lyrics" FontWeight="SemiBold" />
                      <TextBlock x:Name="OverwriteLyricsSettingDescription" Text="Replace lyrics already present in the destination." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="280" HorizontalAlignment="Right">
                      <ToggleSwitch x:Name="LyricsOverrideToggle" HorizontalAlignment="Right" Toggled="SettingsControl_Changed" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="LyricsRomanizationSettingTitle"
                                 FontWeight="SemiBold"
                                 Text="Include romanization when syncing"/>
                      <TextBlock x:Name="LyricsRomanizationSettingDescription"
                                 Text="Include reading lines in the destination's lyrics. Original cache remains unchanged."
                                 TextWrapping="WrapWholeWords"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="LyricsRomanizationToggle"
                                  Grid.Column="1" HorizontalAlignment="Right"
                                  Toggled="SettingsControl_Changed"/>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="LyricsStorageSettingTitle" Text="Lyrics storage" FontWeight="SemiBold" />
                      <TextBlock x:Name="LyricsStorageSettingDescription" Text="Choose embedded tags or sidecar .lrc files." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="LyricsStorageModeBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SettingsControl_Changed">
                      <ComboBoxItem x:Name="LyricsStorageEmbeddedItem" Content="Embedded in audio file" Tag="embedded" />
                      <ComboBoxItem x:Name="LyricsStorageSidecarItem" Content="Sidecar .lrc file" Tag="sidecar" />
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="LyricsCacheSettingTitle" Text="Lyrics cache lifetime" FontWeight="SemiBold" />
                      <TextBlock x:Name="LyricsCacheSettingDescription" Text="How long a result stays fresh before MusicLoom checks again." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <NumberBox
                        x:Name="LyricsRefreshHoursBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Minimum="1"
                        Maximum="315360000"
                        Value="86400"
                        SmallChange="60"
                        LargeChange="3600"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="LyricsRefreshHoursBox_ValueChanged" />
                  </Grid>
                </Border>
                <Border Padding="18" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock x:Name="LyricsEditorSettingTitle"
                                 Text="Lyrics editor" FontWeight="SemiBold" />
                      <TextBlock x:Name="LyricsEditorSettingDescription"
                                 Text="Use default editor or choose an application."
                                 Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="LyricsEditorPathBox" Grid.Column="1"
                             PlaceholderText="System default"
                             TextChanged="SettingsControl_Changed" />
                    <Button x:Name="BrowseLyricsEditorButton" Grid.Column="2"
                            Content="Browse…" Click="BrowseLyricsEditorButton_Click" />
                    <Button x:Name="ResetLyricsEditorButton" Grid.Column="3"
                            Content="Reset" Click="ResetLyricsEditorButton_Click" />
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock x:Name="AppearanceSettingsHeadingText" Text="Appearance" FontSize="18" FontWeight="SemiBold" />

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ThemeSettingTitle"
                        Text="Theme"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="ThemeBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="SettingsControl_Changed">
                      <ComboBoxItem x:Name="ThemeSystemItem" Content="Use system setting" Tag="system" />
                      <ComboBoxItem x:Name="ThemeLightItem" Content="Light" Tag="light" />
                      <ComboBoxItem x:Name="ThemeDarkItem" Content="Dark" Tag="dark" />
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="LongTextSettingTitle"
                        Text="Long text display"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="LongTextModeBox"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="SettingsControl_Changed">
                      <ComboBoxItem x:Name="LongTextAutoScrollItem" Content="Auto-scroll" Tag="autoScroll" />
                      <ComboBoxItem x:Name="LongTextHoverItem" Content="Show on hover" Tag="hover" />
                      <ComboBoxItem x:Name="LongTextWrapItem" Content="Wrap" Tag="wrap" />
                    </ComboBox>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="AcrylicSettingTitle" Text="Acrylic backdrop" FontWeight="SemiBold" />
                      <TextBlock x:Name="AcrylicSettingDescription" Text="Use desktop acrylic instead of the default Mica backdrop." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Width="280" HorizontalAlignment="Right">
                      <ToggleSwitch x:Name="AcrylicToggle" HorizontalAlignment="Right" Toggled="SettingsControl_Changed" />
                    </Grid>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="AccentSettingTitle" Text="Accent color" FontWeight="SemiBold" />
                      <TextBlock x:Name="AccentSettingDescription" Text="Customize MusicLoom's primary accent or follow Windows." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="AccentControlRail"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal"
                        Spacing="8">
                      <Border x:Name="AccentPreview" Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                      <Button x:Name="ChooseAccentButton" Content="Choose…" Click="ChooseAccentButton_Click" />
                      <Button x:Name="ResetAccentButton" Content="Use system" Click="ResetAccentButton_Click" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Padding="18" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock x:Name="LanguageSettingTitle" Text="Interface language" FontWeight="SemiBold" />
                      <TextBlock x:Name="LanguageSettingDescription" Visibility="Collapsed" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SettingsControl_Changed">
                      <ComboBoxItem Content="English" Tag="en-US" />
                      <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                    </ComboBox>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="10">
                <TextBlock
                    x:Name="LogsSettingsHeadingText"
                    Text="Logs"
                    FontSize="18"
                    FontWeight="SemiBold" />

                <Border
                    Padding="18"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                      <TextBlock
                          x:Name="DiagnosticsLogSettingTitle"
                          Text="Diagnostic log"
                          FontWeight="SemiBold" />
                      <ScrollViewer
                          x:Name="DiagnosticsLogPathViewport"
                          HorizontalContentAlignment="Stretch"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollMode="Disabled"
                          ZoomMode="Disabled"
                          IsTabStop="False">
                        <TextBlock
                            x:Name="DiagnosticsLogPathText"
                            Text=""
                            TextWrapping="NoWrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                          <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="DiagnosticsLogPathTranslateTransform" />
                          </TextBlock.RenderTransform>
                        </TextBlock>
                      </ScrollViewer>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Width="280"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                      <Button
                          x:Name="OpenLogFileButton"
                          Content="Open log"
                          Click="OpenLogFileButton_Click" />
                      <Button
                          x:Name="OpenLogFolderButton"
                          Content="Open folder"
                          Click="OpenLogFolderButton_Click" />
                      <Button
                          x:Name="ClearLogButton"
                          Content="Clear"
                          Click="ClearLogButton_Click" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border
                    Padding="14"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="DiagnosticsConsoleTitle"
                        Text="Live diagnostic console"
                        FontWeight="SemiBold" />
                    <TextBox
                        x:Name="DiagnosticsConsole"
                        MinHeight="220"
                        MaxHeight="360"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock x:Name="SettingsStatusText" Visibility="Collapsed" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid
          x:Name="MatchOverlay"
          Grid.Row="0"
          Grid.RowSpan="2"
          Canvas.ZIndex="100"
          Visibility="Collapsed">
          <Grid.Background>
            <SolidColorBrush Color="#66000000" />
          </Grid.Background>
          <Border
              x:Name="MatchDialogSurface"
              MaxWidth="1200"
              MaxHeight="640"
              Margin="24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              CornerRadius="12"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid
                  Padding="18,14,12,10"
                  ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MatchDialogTitleText"
                    Text="Find NetEase match"
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="MatchDialogCloseButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MatchDialogCloseButton_Click"
                    ToolTipService.ToolTip="Close">
                  <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
              </Grid>
              <ContentControl
                  x:Name="MatchDialogHost"
                  Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Margin="18,0,18,18" />
            </Grid>
          </Border>
      </Grid>

      <Border
          x:Name="PlayerBar"
          Grid.Row="2"
          Padding="24,16"
          BorderThickness="0,1,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid ColumnSpacing="22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="190" />
          </Grid.ColumnDefinitions>

          <Button
              x:Name="PlayerArtworkButton"
              Width="72"
              Height="72"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              DoubleTapped="PlayerArtworkButton_DoubleTapped"
              ToolTipService.ToolTip="Locate playing track">
            <Border
                x:Name="PlayerArtworkSurface"
                Width="72"
                Height="72"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
              <Grid>
                <Image
                    x:Name="PlayerArtworkImage"
                    Stretch="Uniform" />
                <FontIcon
                    x:Name="PlayerArtworkPlaceholder"
                    Glyph="&#xE8D6;"
                    FontSize="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </Border>
          </Button>

          <StackPanel
              Grid.Column="1"
              Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="8">
            <Button
                x:Name="PlayerPreviousButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="PlayerPreviousButton_Click"
                ToolTipService.ToolTip="Previous">
              <FontIcon Glyph="&#xE892;" FontSize="16" />
            </Button>
            <Button
                x:Name="PlayerPlayPauseButton"
                Width="44"
                Height="44"
                Padding="0"
                Click="PlayerPlayPauseButton_Click"
                ToolTipService.ToolTip="Play">
              <SymbolIcon
                  x:Name="PlayerPlayPauseIcon"
                  Symbol="Play" />
            </Button>
            <Button
                x:Name="PlayerNextButton"
                Width="36"
                Height="36"
                Padding="0"
                Click="PlayerNextButton_Click"
                ToolTipService.ToolTip="Next">
              <FontIcon Glyph="&#xE893;" FontSize="16" />
            </Button>
          </StackPanel>

          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="PlayerMainMetadata" Spacing="3"
                          MinHeight="40" VerticalAlignment="Center">
                <ScrollViewer
                    x:Name="PlayerTitleViewport"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled"
                    IsTabStop="False">
                  <TextBlock
                      x:Name="PlayerTitleText"
                      Text="Nothing playing"
                      FontSize="15"
                      FontWeight="SemiBold"
                      TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                      <TranslateTransform x:Name="PlayerTitleTranslateTransform" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </ScrollViewer>
                <ScrollViewer
                    x:Name="PlayerMetadataViewport"
                    HorizontalContentAlignment="Stretch"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled"
                    IsTabStop="False">
                  <TextBlock
                      x:Name="PlayerMetadataText"
                      Text=""
                      FontSize="12"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                      <TranslateTransform x:Name="PlayerMetadataTranslateTransform" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </ScrollViewer>
              </StackPanel>
              <Grid x:Name="PlayerSourceMetadata" Grid.Column="1"
                    MinHeight="40" VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PlayerSourceText" Grid.Row="0"
                           Text="" FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="PlayerTimeText" Grid.Row="1"
                           Text="0:00 / 0:00" FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </Grid>
            </Grid>

            <Slider
                x:Name="PlayerProgressSlider"
                Grid.Row="1"
                Minimum="0"
                Maximum="1"
                Value="0"
                Margin="0,6,0,0"
                ValueChanged="PlayerProgressSlider_ValueChanged">
              <Slider.ThumbToolTipValueConverter>
                <local:TimeSliderValueConverter />
              </Slider.ThumbToolTipValueConverter>
            </Slider>

          </Grid>

          <Grid Grid.Column="3" VerticalAlignment="Center" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="108" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="PlayerVolumeIcon"
                Glyph="&#xE767;"
                VerticalAlignment="Center"
                FontSize="16" />
            <Slider
                x:Name="PlayerVolumeSlider"
                Grid.Column="1"
                Width="108"
                Minimum="0"
                Maximum="100"
                Value="75"
                StepFrequency="1"
                ValueChanged="PlayerVolumeSlider_ValueChanged">
              <Slider.ThumbToolTipValueConverter>
                <local:PercentageSliderValueConverter />
              </Slider.ThumbToolTipValueConverter>
            </Slider>
            <Button x:Name="ImmersiveOpenButton" Grid.Column="2"
                    Width="34" Height="34" Padding="0"
                    Click="ImmersiveOpenButton_Click"
                    ToolTipService.ToolTip="Fullscreen immersive player">
              <FontIcon Glyph="&#xE740;" FontSize="16" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </NavigationView>
    <Grid x:Name="ImmersiveHost" Grid.Row="1"
          Visibility="Collapsed">
      <local:ImmersivePlayer x:Name="ImmersiveView"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch" />
    </Grid>

  </Grid>
</Window>
