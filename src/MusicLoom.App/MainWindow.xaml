<Window
    x:Class="MusicLoom.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicLoom">
  <NavigationView
      x:Name="Navigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="True"
      PaneDisplayMode="Left"
      SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Overview" Tag="overview">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Library" Tag="library">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Playlists" Tag="playlists">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Activity" Tag="activity">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <ScrollViewer>
      <Grid Padding="32" MaxWidth="1180" HorizontalAlignment="Stretch">
        <StackPanel Spacing="24">
          <StackPanel Spacing="6">
            <TextBlock x:Name="PageTitle" Text="Overview" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="PageSubtitle"
                Text="Scan first, review the plan, then explicitly apply it to the destination library."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
          </StackPanel>

          <Border
              Padding="24"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
            <Grid ColumnSpacing="16" RowSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBox
                  x:Name="ConfigPathBox"
                  Header="Configuration"
                  Text="config.json"
                  PlaceholderText="Path to config.json" />
              <TextBox
                  x:Name="StatePathBox"
                  Grid.Column="1"
                  Header="Incremental state"
                  Text=".musicloom\state.json"
                  PlaceholderText="Path to state.json" />
              <Button
                  x:Name="ScanButton"
                  Grid.Column="2"
                  Content="Scan library"
                  Click="ScanButton_Click"
                  VerticalAlignment="Bottom" />
              <Button
                  x:Name="ApplySyncButton"
                  Grid.Column="3"
                  Content="Apply sync"
                  Click="ApplySyncButton_Click"
                  IsEnabled="False"
                  VerticalAlignment="Bottom" />

              <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="ScanProgressRing" Width="20" Height="20" IsActive="False" />
                <TextBlock
                    x:Name="ScanStatusText"
                    Text="Scan is read-only. Apply sync only writes under the destination library."
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <Button
                  x:Name="CancelSyncButton"
                  Grid.Row="1"
                  Grid.Column="3"
                  Content="Cancel"
                  Click="CancelSyncButton_Click"
                  Visibility="Collapsed"
                  HorizontalAlignment="Right" />
            </Grid>
          </Border>

          <InfoBar
              x:Name="SyncInfoBar"
              IsOpen="False"
              IsClosable="True"
              Severity="Informational" />

          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Tracks" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="TracksValue" Text="—" FontSize="28" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Pending changes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PendingValue" Text="—" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="AudioCopiesText" Text="— audio copies" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Errors" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ErrorsValue" Text="—" FontSize="28" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="Last scan" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LastScanValue" Text="Never" FontSize="28" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <Border
              Padding="16"
              BorderThickness="1"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock Text="Pending plan" Style="{ThemeResource SubtitleTextBlockStyle}" />
              <TextBlock
                  Text="Copy means the audio file itself must be materialized. Enrich means the destination already exists and only the configured processing recipe remains."
                  TextWrapping="Wrap"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <ListView x:Name="PlanList" MaxHeight="480" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </NavigationView>
</Window>
