<Window
    x:Class="MusicLoom.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:local="using:MusicLoom.App"
    mc:Ignorable="d"
    Title="MusicLoom">

  <Grid x:Name="AppRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="MusicLoom"
              BorderThickness="0" />
    <NavigationView
      Grid.Row="1"
      x:Name="Navigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="False"
      OpenPaneLength="190"
      CompactPaneLength="48"
      PaneDisplayMode="Auto"
      Background="Transparent"
      SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem x:Name="LibraryNav" Content="Library" Tag="library">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="PlaylistsNav" Content="Playlists" Tag="playlists">
        <NavigationViewItem.Icon><FontIcon Glyph="&#xE90B;" /></NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem x:Name="SettingsNav" Content="Settings" Tag="settings">
        <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <InfoBar
          x:Name="AppInfoBar"
          Grid.Row="0"
          Margin="24,12,24,0"
          IsOpen="False"
          IsClosable="True"
          Severity="Informational" />

      <Grid Grid.Row="1">
        <!-- Library -->
        <Grid x:Name="LibraryPage" Padding="28,22,28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="18">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="3">
              <TextBlock x:Name="LibraryTitleText" Text="Music library" FontSize="32" FontWeight="SemiBold" />
              <TextBlock
                  x:Name="LibrarySubtitleText"
                  Text="Browse, inspect and sync your local collection."
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button x:Name="ScanButton" Padding="10,5" Click="ScanButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14"><SymbolIcon Symbol="Refresh" /></Viewbox>
                  <TextBlock x:Name="ScanButtonText" Text="Refresh library" />
                </StackPanel>
              </Button>
              <DropDownButton x:Name="AutoMatchButton" Padding="10,5"
                              IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Glyph="&#xE721;" FontSize="14" />
                  <TextBlock x:Name="AutoMatchButtonText" Text="Auto-match" />
                </StackPanel>
                <DropDownButton.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="AutoMatchNeteaseItem"
                                    Text="NetEase Music (audio fingerprint)"
                                    Click="AutoMatchNeteaseItem_Click" />
                    <MenuFlyoutItem x:Name="AutoMatchQqItem"
                                    Text="QQ Music (metadata)"
                                    Click="AutoMatchQqItem_Click" />
                    <MenuFlyoutItem x:Name="AutoMatchKugouItem"
                                    Text="KuGou Music (metadata)"
                                    Click="AutoMatchKugouItem_Click" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
              <Button x:Name="ConfirmSelectedMatchesButton"
                      Padding="10,5" Click="ConfirmSelectedMatchesButton_Click"
                      IsEnabled="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Glyph="&#xE73E;" FontSize="14" />
                  <TextBlock x:Name="ConfirmSelectedMatchesText" Text="Confirm selected matches" />
                </StackPanel>
              </Button>
              <Button x:Name="ClearSelectedMatchesButton"
                      Padding="10,5" Click="ClearSelectedMatchesButton_Click"
                      IsEnabled="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <FontIcon Glyph="&#xE74D;" FontSize="14" />
                  <TextBlock x:Name="ClearSelectedMatchesText" Text="Clear selected matches" />
                </StackPanel>
              </Button>
              <Button x:Name="SyncButton" Padding="10,5" Style="{StaticResource AccentButtonStyle}" Click="SyncButton_Click" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14"><SymbolIcon Symbol="Sync" /></Viewbox>
                  <TextBlock x:Name="SyncButtonText" Text="Sync pending" />
                </StackPanel>
              </Button>
              <Button x:Name="CancelButton" Padding="10,5" Click="CancelButton_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14"><SymbolIcon Symbol="Cancel" /></Viewbox>
                  <TextBlock x:Name="CancelButtonText" Text="Cancel" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- One aligned toolbar: search, progressive filters/sort, then counts. -->
          <Grid x:Name="LibraryToolbarRow" Grid.Row="1" Margin="0,16,0,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="LibrarySearchRegion" Grid.Column="0" Width="248"
                  HorizontalAlignment="Left" ColumnSpacing="6"
                  VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button x:Name="LibrarySearchButton" Width="32" Height="32"
                      Padding="0" Background="Transparent" BorderThickness="0"
                      Click="LibrarySearchButton_Click"
                      ToolTipService.ToolTip="Focus library search">
                <SymbolIcon Symbol="Find"/>
              </Button>
              <TextBox x:Name="LibrarySearchBox" Grid.Column="1"
                       MinWidth="140" HorizontalAlignment="Stretch"
                       PlaceholderText="Search title, artist, album or path"
                       TextChanged="LibrarySearchBox_TextChanged"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" HorizontalAlignment="Left">
              <Button x:Name="LibraryFacetsButton" Padding="12,8" MinWidth="94">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Viewbox x:Name="LibraryFilterIcon" Width="16" Height="16"><PathIcon Width="20" Height="20" Data="M7.5 13H12.5C12.7761 13 13 13.2239 13 13.5C13 13.7455 12.8231 13.9496 12.5899 13.9919L12.5 14H7.5C7.22386 14 7 13.7761 7 13.5C7 13.2545 7.17688 13.0504 7.41012 13.0081L7.5 13H12.5H7.5ZM5.5 9H14.5C14.7761 9 15 9.22386 15 9.5C15 9.74546 14.8231 9.94961 14.5899 9.99194L14.5 10H5.5C5.22386 10 5 9.77614 5 9.5C5 9.25454 5.17688 9.05039 5.41012 9.00806L5.5 9H14.5H5.5ZM3.5 5H16.5C16.7761 5 17 5.22386 17 5.5C17 5.74546 16.8231 5.94961 16.5899 5.99194L16.5 6H3.5C3.22386 6 3 5.77614 3 5.5C3 5.25454 3.17688 5.05039 3.41012 5.00806L3.5 5H16.5H3.5Z"/></Viewbox>
                    <TextBlock x:Name="LibraryFacetsLabel" Text="Filters" VerticalAlignment="Center"/>
                  </StackPanel>
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <ScrollViewer MaxHeight="490"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Width="272" Spacing="9">
                      <TextBlock x:Name="LibraryFacetPanelHeading"
                                 Text="Filter by" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="LibraryStatusFacetLabel"
                                 Text="Sync status" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <ComboBox x:Name="LibraryFilterBox" HorizontalAlignment="Stretch"
                        SelectionChanged="LibraryFilterBox_SelectionChanged">
                <ComboBoxItem x:Name="LibraryFilterAllItem" Content="All statuses" Tag="all"/>
                <ComboBoxItem x:Name="LibraryFilterPendingItem" Content="Pending" Tag="pending"/>
                <ComboBoxItem x:Name="LibraryFilterSyncedItem" Content="Synced" Tag="synced"/>
                <ComboBoxItem x:Name="LibraryFilterWarningsItem" Content="Warnings" Tag="warning"/>
                <ComboBoxItem x:Name="LibraryFilterErrorsItem" Content="Errors" Tag="error"/>
                <ComboBoxItem x:Name="LibraryFilterSyncingItem" Content="Syncing" Tag="syncing"/>
              </ComboBox>
                      <TextBlock x:Name="LibraryLyricsFacetLabel"
                                 Text="Lyrics" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="LibraryLyricsFacetBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibraryFacetFilter_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="All lyric statuses"/>
                        <ComboBoxItem Tag="present" Content="Has lyrics"/>
                        <ComboBoxItem Tag="missing" Content="No lyrics"/>
                      </ComboBox>
                      <TextBlock x:Name="LibraryNeteaseFacetLabel"
                                 Text="NetEase Music" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="LibraryNeteaseFacetBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibraryFacetFilter_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="All NetEase matches"/>
                        <ComboBoxItem Tag="matched" Content="Matched on NetEase"/>
                        <ComboBoxItem Tag="confirmed" Content="NetEase confirmed"/>
                        <ComboBoxItem Tag="unconfirmed" Content="NetEase needs confirmation"/>
                        <ComboBoxItem Tag="missing" Content="Not matched on NetEase"/>
                        <ComboBoxItem Tag="empty" Content="NetEase match cleared"/>
                      </ComboBox>
                      <TextBlock x:Name="LibraryQqFacetLabel"
                                 Text="QQ Music" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="LibraryQqFacetBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibraryFacetFilter_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="All QQ Music matches"/>
                        <ComboBoxItem Tag="matched" Content="Matched on QQ Music"/>
                        <ComboBoxItem Tag="confirmed" Content="QQ Music confirmed"/>
                        <ComboBoxItem Tag="unconfirmed" Content="QQ Music needs confirmation"/>
                        <ComboBoxItem Tag="missing" Content="Not matched on QQ Music"/>
                        <ComboBoxItem Tag="empty" Content="QQ Music match cleared"/>
                      </ComboBox>
                      <TextBlock x:Name="LibraryKugouFacetLabel"
                                 Text="KuGou Music" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="LibraryKugouFacetBox"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="LibraryFacetFilter_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="All KuGou matches"/>
                        <ComboBoxItem Tag="matched" Content="Matched on KuGou"/>
                        <ComboBoxItem Tag="confirmed" Content="KuGou confirmed"/>
                        <ComboBoxItem Tag="unconfirmed" Content="KuGou needs confirmation"/>
                        <ComboBoxItem Tag="missing" Content="Not matched on KuGou"/>
                        <ComboBoxItem Tag="empty" Content="KuGou match cleared"/>
                      </ComboBox>
                      <TextBlock x:Name="LibraryMiguFacetLabel"
                                 Text="Migu Music" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      <ComboBox x:Name="LibraryMiguFacetBox" HorizontalAlignment="Stretch"
                                SelectionChanged="LibraryFacetFilter_SelectionChanged">
                        <ComboBoxItem Tag="all" Content="All Migu matches"/>
                        <ComboBoxItem Tag="matched" Content="Matched on Migu"/>
                        <ComboBoxItem Tag="confirmed" Content="Migu confirmed"/>
                        <ComboBoxItem Tag="unconfirmed" Content="Migu needs confirmation"/>
                        <ComboBoxItem Tag="missing" Content="Not matched on Migu"/>
                        <ComboBoxItem Tag="empty" Content="Migu match cleared"/>
                      </ComboBox>
                      <Button x:Name="LibraryClearFacetsButton"
                              HorizontalAlignment="Right"
                              Content="Clear filters"
                              Click="LibraryClearFacetsButton_Click"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button x:Name="LibrarySortMenuButton"
                      Padding="12,8" MinWidth="112">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Viewbox x:Name="LibrarySortIcon" Width="16" Height="16"><PathIcon Width="20" Height="20" Data="M2.35355 7.35418L4.99792 4.70981V16.5C4.99792 16.7761 5.22178 17 5.49792 17C5.77407 17 5.99792 16.7761 5.99792 16.5V4.7053L8.64682 7.3542C8.84209 7.54946 9.15867 7.54946 9.35393 7.3542C9.54919 7.15893 9.54919 6.84235 9.35393 6.64709L5.86386 3.15701L5.85387 3.14675C5.81608 3.10895 5.77374 3.07847 5.72861 3.05531C5.65697 3.01841 5.57828 2.99998 5.49959 3L5.49792 3C5.3441 3 5.20649 3.06947 5.11477 3.17874L1.64645 6.64707C1.45118 6.84233 1.45118 7.15891 1.64645 7.35418C1.84171 7.54944 2.15829 7.54944 2.35355 7.35418ZM17.6468 12.6458L15.0025 15.2902L15.0025 3.5C15.0025 3.22386 14.7786 3 14.5025 3C14.2263 3 14.0025 3.22386 14.0025 3.5L14.0025 15.2947L11.3536 12.6458C11.1583 12.4505 10.8417 12.4505 10.6464 12.6458C10.4512 12.8411 10.4512 13.1577 10.6464 13.3529L14.1365 16.843L14.1465 16.8533C14.1843 16.891 14.2266 16.9215 14.2718 16.9447C14.3434 16.9816 14.4221 17 14.5008 17L14.5025 17C14.6563 17 14.7939 16.9305 14.8856 16.8213L18.3539 13.3529C18.5492 13.1577 18.5492 12.8411 18.3539 12.6458C18.1587 12.4506 17.8421 12.4506 17.6468 12.6458Z"/></Viewbox>
