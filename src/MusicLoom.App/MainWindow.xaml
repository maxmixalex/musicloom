<Window
    x:Class="MusicLoom.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MusicLoom">
  <NavigationView
      x:Name="Navigation"
      IsBackButtonVisible="Collapsed"
      IsSettingsVisible="False"
      OpenPaneLength="184"
      CompactPaneLength="48"
      PaneDisplayMode="Auto"
      SelectionChanged="Navigation_SelectionChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem
          x:Name="LibraryNav"
          Content="Library"
          Tag="library">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Audio" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem
          x:Name="ActivityNav"
          Content="Activity"
          Tag="activity">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Sync" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem
          x:Name="SettingsNav"
          Content="Settings"
          Tag="settings">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Setting" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <InfoBar
          x:Name="AppInfoBar"
          Grid.Row="0"
          Margin="24,12,24,0"
          IsOpen="False"
          IsClosable="True"
          Severity="Informational" />

      <Grid Grid.Row="1">
        <Grid
            x:Name="LibraryPage"
            Padding="28,22,28,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                VerticalAlignment="Center"
                Spacing="3">
              <TextBlock
                  x:Name="LibraryTitleText"
                  Text="Music library"
                  FontSize="32"
                  FontWeight="SemiBold" />
              <TextBlock
                  x:Name="LibrarySubtitleText"
                  Text="Browse, inspect and sync your local collection."
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
              <Button
                  x:Name="ScanButton"
                  Content="Refresh library"
                  Click="ScanButton_Click" />
              <Button
                  x:Name="SyncButton"
                  Content="Sync pending"
                  Style="{StaticResource AccentButtonStyle}"
                  Click="SyncButton_Click"
                  IsEnabled="False" />
              <Button
                  x:Name="CancelButton"
                  Content="Cancel"
                  Click="CancelButton_Click"
                  Visibility="Collapsed" />
              <Button
                  x:Name="OpenDestinationButton"
                  Content="Open destination"
                  Click="OpenDestinationButton_Click"
                  IsEnabled="False" />
            </StackPanel>
          </Grid>

          <Grid
              Grid.Row="1"
              Margin="0,16,0,16"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12,7"
                CornerRadius="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    x:Name="TracksLabelText"
                    Text="Tracks"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="TracksValue"
                    Text="—"
                    FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="12,7"
                CornerRadius="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    x:Name="PendingLabelText"
                    Text="Pending tracks"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="PendingValue"
                    Text="—"
                    FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="12,7"
                CornerRadius="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    x:Name="AncillaryLabelText"
                    Text="Extra updates"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="AncillaryValue"
                    Text="—"
                    FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <Border
                Grid.Column="3"
                Padding="12,7"
                CornerRadius="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock
                    x:Name="ErrorsLabelText"
                    Text="Errors"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="ErrorsValue"
                    Text="—"
                    FontWeight="SemiBold" />
              </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Spacing="8">
              <ProgressBar
                  x:Name="OperationProgressBar"
                  Width="180"
                  Height="3"
                  Minimum="0"
                  Maximum="100"
                  Visibility="Collapsed" />
              <TextBlock
                  x:Name="OperationStatusText"
                  Text="Ready."
                  MaxWidth="420"
                  VerticalAlignment="Center"
                  TextTrimming="CharacterEllipsis"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock
                  Text="·"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
              <TextBlock
                  x:Name="LastScanLabelText"
                  Text="Last scan"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              <TextBlock
                  x:Name="LastScanValue"
                  Text="Never"
                  FontWeight="SemiBold" />
            </StackPanel>
          </Grid>

          <Grid
              Grid.Row="2"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*" MinWidth="420" />
              <ColumnDefinition Width="7*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <Grid>
                <Grid
                    x:Name="LibraryListPanel"
                    Padding="12"
                    Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="LibrarySearchBox"
                        PlaceholderText="Search title, artist, album or path"
                        TextChanged="LibrarySearchBox_TextChanged" />
                    <ComboBox
                        x:Name="LibraryFilterBox"
                        Grid.Column="1"
                        SelectionChanged="LibraryFilterBox_SelectionChanged">
                      <ComboBoxItem
                          x:Name="LibraryFilterAllItem"
                          Content="All tracks"
                          Tag="all" />
                      <ComboBoxItem
                          x:Name="LibraryFilterPendingItem"
                          Content="Pending"
                          Tag="pending" />
                      <ComboBoxItem
                          x:Name="LibraryFilterSyncedItem"
                          Content="Up to date"
                          Tag="synced" />
                      <ComboBoxItem
                          x:Name="LibraryFilterErrorsItem"
                          Content="Errors"
                          Tag="error" />
                    </ComboBox>
                  </Grid>

                  <TextBlock
                      x:Name="LibraryVisibleCountText"
                      Grid.Row="1"
                      Margin="4,10,4,6"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Text="0 tracks" />

                  <ListView
                      x:Name="LibraryList"
                      Grid.Row="2"
                      SelectionMode="Single"
                      SelectionChanged="LibraryList_SelectionChanged"
                      HorizontalContentAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                      <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                      </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Grid
                            MinHeight="62"
                            Padding="12,8"
                            ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <Border
                              Width="36"
                              Height="36"
                              CornerRadius="6"
                              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                              VerticalAlignment="Center">
                            <FontIcon
                                Glyph="&#xE189;"
                                FontSize="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          </Border>

                          <StackPanel
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Spacing="1">
                            <TextBlock
                                Text="{Binding Title}"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding ArtistAlbum}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                          </StackPanel>

                          <TextBlock
                              Grid.Column="2"
                              Text="{Binding StatusText}"
                              Margin="8,0,2,0"
                              VerticalAlignment="Center"
                              FontSize="12"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </Grid>

                <StackPanel
                    x:Name="LibraryEmptyPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="340"
                    Spacing="10">
                  <FontIcon
                      Glyph="&#xE8D6;"
                      FontSize="42"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock
                      x:Name="LibraryEmptyTitleText"
                      Text="Set up your music library"
                      FontSize="22"
                      FontWeight="SemiBold"
                      TextAlignment="Center" />
                  <TextBlock
                      x:Name="LibraryEmptyBodyText"
                      Text="Choose the source and destination once. MusicLoom keeps the source read-only."
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <Button
                      x:Name="OpenSettingsButton"
                      Content="Open settings"
                      Click="OpenSettingsButton_Click"
                      HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>

            <Border
                Grid.Column="1"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
              <Grid Padding="20">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="20">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border
                      Width="156"
                      Height="156"
                      CornerRadius="10"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                      <Image
                          x:Name="CoverImage"
                          Stretch="UniformToFill" />
                      <TextBlock
                          x:Name="CoverPlaceholderText"
                          Text="No artwork"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                  </Border>

                  <StackPanel
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Spacing="5">
                    <TextBlock
                        x:Name="TrackTitleText"
                        Text="Select a track"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="TrackArtistText"
                        Text="—"
                        FontSize="16"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TrackAlbumText"
                        Text="—"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Border
                        HorizontalAlignment="Left"
                        Margin="0,5,0,0"
                        Padding="9,4"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                      <TextBlock
                          x:Name="TrackStatusText"
                          Text="—"
                          FontSize="12"
                          FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                </Grid>

                <TabView
                    x:Name="DetailTabs"
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    IsAddTabButtonVisible="False"
                    CanDragTabs="False"
                    TabWidthMode="SizeToContent">
                  <TabViewItem
                      x:Name="LyricsTab"
                      Header="Lyrics">
                    <Grid Padding="4,12,4,4">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <TextBlock
                          x:Name="LyricsSourceText"
                          Margin="2,0,0,10"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap" />
                      <ScrollViewer
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="LyricsPreviewText"
                            Text="Select a track to inspect its lyrics."
                            FontSize="15"
                            LineHeight="24"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                      </ScrollViewer>
                    </Grid>
                  </TabViewItem>

                  <TabViewItem
                      x:Name="MatchTab"
                      Header="NetEase match">
                    <Grid Padding="4,12,4,4">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                          <TextBlock
                              x:Name="CurrentMatchText"
                              Text="No match cached."
                              FontWeight="SemiBold"
                              TextWrapping="Wrap" />
                          <TextBlock
                              x:Name="CandidateStatusText"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="FindMatchesButton"
                            Grid.Column="1"
                            Content="Find matches"
                            Click="FindMatchesButton_Click"
                            IsEnabled="False" />
                      </Grid>

                      <ListView
                          x:Name="NeteaseCandidatesList"
                          Grid.Row="1"
                          Margin="0,10,0,8"
                          MaxHeight="180"
                          SelectionChanged="NeteaseCandidatesList_SelectionChanged">
                        <ListView.ItemTemplate>
                          <DataTemplate>
                            <Grid
                                Padding="8,6"
                                ColumnSpacing="10">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Spacing="1">
                                <TextBlock
                                    Text="{Binding Name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding Artist}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  Text="{Binding Album}"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  TextTrimming="CharacterEllipsis"
                                  MaxWidth="180" />
                            </Grid>
                          </DataTemplate>
                        </ListView.ItemTemplate>
                      </ListView>

                      <ScrollViewer
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="CandidateLyricsPreviewText"
                            Text="Select a candidate to preview its lyrics."
                            FontSize="14"
                            LineHeight="22"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                      </ScrollViewer>

                      <Button
                          x:Name="UseSelectedMatchButton"
                          Grid.Row="3"
                          Margin="0,10,0,0"
                          Content="Use selected match"
                          Style="{StaticResource AccentButtonStyle}"
                          Click="UseSelectedMatchButton_Click"
                          IsEnabled="False"
                          HorizontalAlignment="Left" />
                    </Grid>
                  </TabViewItem>

                  <TabViewItem
                      x:Name="FileTab"
                      Header="File">
                    <ScrollViewer Padding="4,12,4,4">
                      <StackPanel Spacing="18">
                        <StackPanel Spacing="5">
                          <TextBlock
                              x:Name="SourcePathHeadingText"
                              Text="Source"
                              FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="TrackSourcePathText"
                              Text=""
                              TextWrapping="Wrap"
                              IsTextSelectionEnabled="True"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                          <TextBlock
                              x:Name="DestinationPathHeadingText"
                              Text="Destination"
                              FontWeight="SemiBold" />
                          <TextBlock
                              x:Name="TrackDestinationPathText"
                              Text=""
                              TextWrapping="Wrap"
                              IsTextSelectionEnabled="True"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </TabViewItem>
                </TabView>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <ScrollViewer
            x:Name="ActivityPage"
            Visibility="Collapsed">
          <Grid
              Padding="32"
              MaxWidth="1080"
              HorizontalAlignment="Stretch">
            <StackPanel Spacing="18">
              <TextBlock
                  x:Name="ActivityTitleText"
                  Text="Activity"
                  FontSize="32"
                  FontWeight="SemiBold" />
              <TextBlock
                  x:Name="ActivitySubtitleText"
                  Text="Recent scans, syncs, recoveries and errors."
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

              <Border
                  Padding="20"
                  CornerRadius="10"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6">
                  <TextBlock
                      x:Name="LastRunTitle"
                      Text="No sync run yet"
                      FontSize="18"
                      FontWeight="SemiBold" />
                  <TextBlock
                      x:Name="LastRunSummaryText"
                      Text="Refresh the library to begin."
                      TextWrapping="Wrap"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
              </Border>

              <StackPanel
                  Orientation="Horizontal"
                  Spacing="8">
                <Button
                    x:Name="OpenLogFolderButton"
                    Content="Open log folder"
                    Click="OpenLogFolderButton_Click" />
                <Button
                    x:Name="ClearActivityButton"
                    Content="Clear activity"
                    Click="ClearActivityButton_Click" />
                <TextBlock
                    x:Name="LogPathText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
              </StackPanel>

              <Border
                  Padding="8"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="10">
                <ListView
                    x:Name="ActivityList"
                    MinHeight="360" />
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <ScrollViewer
            x:Name="SettingsPage"
            Visibility="Collapsed">
          <Grid
              Padding="32"
              MaxWidth="980"
              HorizontalAlignment="Stretch">
            <StackPanel Spacing="20">
              <StackPanel Spacing="3">
                <TextBlock
                    x:Name="SettingsTitleText"
                    Text="Settings"
                    FontSize="32"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="SettingsSubtitleText"
                    Text="Configure the library once; MusicLoom stores settings outside the app folder."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
              </StackPanel>

              <Border
                  Padding="22"
                  BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  CornerRadius="10">
                <StackPanel Spacing="16">
                  <TextBlock
                      x:Name="LibrarySettingsHeadingText"
                      Text="Library"
                      FontSize="18"
                      FontWeight="SemiBold" />

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SourcePathBox"
                        Header="Source library"
                        PlaceholderText="Folder containing your original music" />
                    <Button
                        x:Name="BrowseSourceButton"
                        Grid.Column="1"
                        Content="Browse…"
                        Click="BrowseSourceButton_Click"
                        VerticalAlignment="Bottom" />
                  </Grid>

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="DestinationPathBox"
                        Header="Destination library"
                        PlaceholderText="Separate output folder" />
                    <Button
                        x:Name="BrowseDestinationButton"
                        Grid.Column="1"
                        Content="Browse…"
                        Click="BrowseDestinationButton_Click"
                        VerticalAlignment="Bottom" />
                  </Grid>

                  <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="PlaylistSourcePathBox"
                        Header="MusicBee playlist folder (optional)"
                        PlaceholderText="Folder containing .m3u playlists" />
                    <Button
                        x:Name="BrowsePlaylistButton"
                        Grid.Column="1"
                        Content="Browse…"
                        Click="BrowsePlaylistButton_Click"
                        VerticalAlignment="Bottom" />
                  </Grid>

                  <TextBox
                      x:Name="PlaylistBaseBox"
                      Header="Playlist path on phone"
                      PlaceholderText="/storage/emulated/0/Music/" />
                </StackPanel>
              </Border>

              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="22"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10">
                  <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="LyricsSettingsHeadingText"
                        Text="Lyrics"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <ToggleSwitch
                        x:Name="LyricsEnabledToggle"
                        Header="Fetch lyrics from NetEase" />
                    <ToggleSwitch
                        x:Name="LyricsOverrideToggle"
                        Header="Overwrite existing lyrics" />
                    <ComboBox
                        x:Name="LyricsStorageModeBox"
                        Header="Store lyrics as">
                      <ComboBoxItem
                          x:Name="LyricsStorageEmbeddedItem"
                          Content="Embedded in audio file"
                          Tag="embedded" />
                      <ComboBoxItem
                          x:Name="LyricsStorageSidecarItem"
                          Content="Sidecar .lrc file"
                          Tag="sidecar" />
                    </ComboBox>
                    <NumberBox
                        x:Name="LyricsRefreshHoursBox"
                        Header="Lyrics cache lifetime (hours)"
                        Minimum="1"
                        Maximum="87600"
                        Value="24"
                        SpinButtonPlacementMode="Compact" />
                  </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="22"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="10">
                  <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="RefreshSettingsHeadingText"
                        Text="Interface"
                        FontSize="18"
                        FontWeight="SemiBold" />
                    <ComboBox
                        x:Name="LanguageBox"
                        Header="Interface language">
                      <ComboBoxItem
                          Content="English"
                          Tag="en-US" />
                      <ComboBoxItem
                          Content="简体中文"
                          Tag="zh-CN" />
                    </ComboBox>
                    <TextBlock
                        x:Name="SettingsStorageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="OpenDataFolderButton"
                        Content="Open data folder"
                        Click="OpenDataFolderButton_Click"
                        HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel
                  Orientation="Horizontal"
                  Spacing="10">
                <Button
                    x:Name="SaveSettingsButton"
                    Content="Save settings"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveSettingsButton_Click" />
                <TextBlock
                    x:Name="SettingsStatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
  </NavigationView>
</Window>
