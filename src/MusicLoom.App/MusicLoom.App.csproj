<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>MusicLoom.App</RootNamespace>
    <AssemblyName>MusicLoom</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MusicLoom.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en-US;zh-CN</SatelliteResourceLanguages>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.250402" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <ProjectReference Include="../MusicLoom.Core/MusicLoom.Core.csproj" />
    <ProjectReference Include="../MusicLoom.Audio.Windows/MusicLoom.Audio.Windows.csproj" />
    <ProjectReference Include="../MusicLoom.Metadata/MusicLoom.Metadata.csproj" />
    <ProjectReference Include="../MusicLoom.Tagging/MusicLoom.Tagging.csproj" />
    <ProjectReference Include="../MusicLoom.Netease/MusicLoom.Netease.csproj" />
    <ProjectReference Include="../MusicLoom.LyricsProviders/MusicLoom.LyricsProviders.csproj" />
    <Content Remove="Assets/MusicLoom.ico" />
    <EmbeddedResource Include="Assets/MusicLoom.ico"
                      LogicalName="MusicLoom.AppIcon.ico" />
  </ItemGroup>
  <Target Name="GenerateMusicLoomWindowsIcon"
          BeforeTargets="PrepareResources;GenerateWin32Resources;CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\tools\Generate-MusicLoomIcon.ps1&quot; -OutputPath &quot;$(MSBuildProjectDirectory)\Assets\MusicLoom.ico&quot;" />
  </Target>
  <Target Name="CopyWinUiResourcesForNativeAot"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and '$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <_MusicLoomWinUiResource Include="$(OutputPath)**\*.xbf" />
      <_MusicLoomWinUiResource Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
        SourceFiles="@(_MusicLoomWinUiResource)"
        DestinationFiles="@(_MusicLoomWinUiResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
        SkipUnchangedFiles="true" />
  </Target>
  <!--
    Work around WindowsAppSDK #6720: dotnet publish can omit the app PRI
    for unpackaged WinUI projects, causing a 0xC000027B startup crash.
    Remove this target once the SDK publish path includes ProjectPriFullPath.
  -->
  <Target Name="AddProjectPriToResolvedFileToPublish"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
