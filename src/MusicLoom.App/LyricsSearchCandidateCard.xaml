<UserControl
    x:Class="MusicLoom.App.LyricsSearchCandidateCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="76">
  <!-- Restored from the pre-QQ/KuGou NetEase candidate in 41fcf8c:
       52px artwork | title, artist, album | ID/duration, link, preview. -->
  <Grid x:Name="CandidateLayout" MinHeight="76"
        Padding="22,8,16,8" ColumnSpacing="12" RowSpacing="3"
        SizeChanged="CandidateLayout_SizeChanged">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="52"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="MetadataRailColumn" Width="220"/>
    </Grid.ColumnDefinitions>
    <Border Width="52" Height="52" CornerRadius="6"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
      <Grid>
        <FontIcon Glyph="&#xE8D6;" FontSize="18"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
        <Image Source="{x:Bind ArtworkSource, Mode=OneWay}"
               Stretch="Uniform"/>
      </Grid>
    </Border>
    <StackPanel x:Name="CandidateInfo" Grid.Column="1"
                Grid.Row="0" Spacing="2"
                VerticalAlignment="Center" MinWidth="0">
      <TextBlock Text="{x:Bind SongTitle, Mode=OneWay}"
                 FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{x:Bind ArtistName, Mode=OneWay}" FontSize="12"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Text="{x:Bind AlbumName, Mode=OneWay}" FontSize="11"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
    <Grid x:Name="CandidateActions" Grid.Column="2" Grid.Row="0"
          ColumnSpacing="8" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2" VerticalAlignment="Center"
                  HorizontalAlignment="Right">
        <TextBlock Text="{x:Bind DurationText, Mode=OneWay}"
                   FontSize="11" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Right"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <HyperlinkButton x:Name="ExternalLinkButton"
                         Padding="0" FontSize="11"
                         Visibility="Collapsed"
                         HorizontalAlignment="Right"/>
      </StackPanel>
      <Button x:Name="PreviewButton" Grid.Column="1"
              Width="36" Height="36" Padding="0"
              VerticalAlignment="Center"
              Click="PreviewButton_Click">
        <SymbolIcon x:Name="PreviewSymbol" Symbol="Play" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
