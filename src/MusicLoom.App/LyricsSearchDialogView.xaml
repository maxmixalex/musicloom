<UserControl x:Class="MusicLoom.App.LyricsSearchDialogView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="12">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Height="500" MaxWidth="1140" HorizontalAlignment="Stretch" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="500" />
        <ColumnDefinition Width="1*" MinWidth="220" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="14" CornerRadius="9" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="SearchHeading" Text="Search" FontSize="18" FontWeight="SemiBold" />
          <ContentControl x:Name="SearchHost" Grid.Row="1"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
      <Border Grid.Column="1" Padding="12" CornerRadius="9" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="CandidatesHeading" Text="Candidates" FontSize="18" FontWeight="SemiBold" />
          <ContentControl x:Name="CandidatesHost" Grid.Row="1"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
      <Border Grid.Column="2" Padding="12" CornerRadius="9" BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock x:Name="LyricsHeading" Text="Lyrics" FontSize="18" FontWeight="SemiBold" />
          <ContentControl x:Name="LyricsHost" Grid.Row="1"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </Border>
    </Grid>
    <ContentControl x:Name="FooterHost" Grid.Row="1" HorizontalAlignment="Right"
      HorizontalContentAlignment="Right" />
  </Grid>
</UserControl>
