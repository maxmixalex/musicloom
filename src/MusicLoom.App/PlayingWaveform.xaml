<UserControl
    x:Class="MusicLoom.App.PlayingWaveform"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">
  <!-- The entire row is a low-contrast Fluent surface. The curve is the
       measured frequency profile of the current 50 ms PCM window,
       not a progress indicator or an endlessly looping artificial wave. -->
  <Grid x:Name="WaveRoot" IsHitTestVisible="False">
    <Canvas x:Name="WaveCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False">
      <Polygon x:Name="WaveArea"
               Fill="{ThemeResource AccentFillColorTertiaryBrush}"
               Opacity="0.16"
               IsHitTestVisible="False" />
      <Polyline x:Name="WaveLine"
                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                StrokeThickness="1.65"
                StrokeLineJoin="Round"
                Opacity="0.8"
                IsHitTestVisible="False" />
    </Canvas>
  </Grid>
</UserControl>
