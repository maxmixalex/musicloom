<UserControl
    x:Class="MusicLoom.App.PlayingWaveform"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="70"
    Height="26"
    Visibility="Collapsed"
    IsHitTestVisible="False">
  <UserControl.Resources>
    <Storyboard x:Name="WaveMotion">
      <DoubleAnimation Storyboard.TargetName="WaveShift"
                       Storyboard.TargetProperty="X"
                       From="0" To="-48"
                       Duration="0:0:2.4"
                       RepeatBehavior="Forever"
                       EnableDependentAnimation="True" />
    </Storyboard>
    <Storyboard x:Name="EchoMotion">
      <DoubleAnimation Storyboard.TargetName="EchoShift"
                       Storyboard.TargetProperty="X"
                       From="-48" To="0"
                       Duration="0:0:3.2"
                       RepeatBehavior="Forever"
                       EnableDependentAnimation="True" />
    </Storyboard>
  </UserControl.Resources>
  <Grid Width="70" Height="26" Opacity="0.16">
    <Grid.Clip>
      <RectangleGeometry Rect="0,0,70,26" />
    </Grid.Clip>
    <Path Stroke="{ThemeResource AccentFillColorDefaultBrush}"
          StrokeThickness="1.8"
          StrokeLineJoin="Round"
          Data="M 0,13 C 8,5 16,5 24,13 C 32,21 40,21 48,13 C 56,5 64,5 72,13 C 80,21 88,21 96,13 C 104,5 112,5 120,13 C 128,21 136,21 144,13">
      <Path.RenderTransform>
        <TranslateTransform x:Name="WaveShift" />
      </Path.RenderTransform>
    </Path>
    <Path Stroke="{ThemeResource AccentFillColorDefaultBrush}"
          StrokeThickness="1"
          Opacity="0.45"
          StrokeLineJoin="Round"
          Data="M 0,13 C 8,19 16,19 24,13 C 32,7 40,7 48,13 C 56,19 64,19 72,13 C 80,7 88,7 96,13 C 104,19 112,19 120,13 C 128,7 136,7 144,13">
      <Path.RenderTransform>
        <TranslateTransform x:Name="EchoShift" />
      </Path.RenderTransform>
    </Path>
  </Grid>
</UserControl>
