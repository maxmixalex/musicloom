<UserControl
    x:Class="MusicLoom.App.PlayingWaveform"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    Visibility="Collapsed">
  <!-- True audio RMS envelope, rendered behind (not beside) the row.
       Accent brush values respond to the user's WinUI theme. -->
  <Grid x:Name="WaveRoot">
    <Path x:Name="UnplayedArea"
          Fill="{ThemeResource AccentFillColorTertiaryBrush}"
          Opacity="0.10"
          IsHitTestVisible="False" />
    <Path x:Name="UnplayedLine"
          Stroke="{ThemeResource AccentFillColorDefaultBrush}"
          StrokeThickness="1.15"
          Opacity="0.20"
          IsHitTestVisible="False" />
    <Grid x:Name="PlayedLayer" IsHitTestVisible="False">
      <Path x:Name="PlayedArea"
            Fill="{ThemeResource AccentFillColorSecondaryBrush}"
            Opacity="0.20" />
      <Path x:Name="PlayedLine"
            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
            StrokeThickness="1.4"
            Opacity="0.38" />
    </Grid>
  </Grid>
</UserControl>
