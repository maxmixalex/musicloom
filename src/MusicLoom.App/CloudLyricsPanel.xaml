<UserControl x:Class="MusicLoom.App.CloudLyricsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MusicLoom.App" MinWidth="760">
  <local:LyricsSearchDialogView x:Name="SearchLayout">
    <local:LyricsSearchDialogView.SearchContent>
      <StackPanel Spacing="10">
        <TextBox x:Name="ArtistBox" Header="Artist" />
        <TextBox x:Name="TitleBox" Header="Title" />
        <TextBox x:Name="AlbumBox" Header="Album" />
        <Button x:Name="AudioRecognizeButton"
                Content="Recognize from audio"
                Click="AudioRecognizeButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch" />
        <Button x:Name="SearchButton" Content="Search by metadata"
                Click="SearchButton_Click"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}" />
        <TextBlock x:Name="ProviderStatus"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </local:LyricsSearchDialogView.SearchContent>
    <local:LyricsSearchDialogView.CandidatesContent>
      <ListView x:Name="CandidatesList"
                  SelectionMode="Single"
                  SelectionChanged="CandidatesList_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3,3,6,3" Padding="9" ColumnSpacing="12"
                    MinHeight="68">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="7"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="18"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image Source="{Binding Artwork}"
                           Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Artist}"
                             FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Album}"
                             FontSize="11"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Duration}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
    </local:LyricsSearchDialogView.CandidatesContent>
    <local:LyricsSearchDialogView.LyricsContent>
      <ListView x:Name="LyricsPreview"
                  SelectionMode="None"
                  DoubleTapped="LyricsPreview_DoubleTapped"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="4,8" Spacing="4">
                <TextBlock Text="{Binding TimestampText}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock local:KaraokeLyricText.Line="{Binding}"
                           TextWrapping="WrapWholeWords"
                           FontSize="16" />
                <TextBlock local:KaraokeLyricText.Line="{Binding}"
                           local:KaraokeLyricText.IsSecondary="True"
                           Visibility="{Binding SecondaryVisibility}"
                           TextWrapping="WrapWholeWords"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
    </local:LyricsSearchDialogView.LyricsContent>
    <local:LyricsSearchDialogView.FooterContent>
      <Button x:Name="UseLyricsButton"
            HorizontalAlignment="Right"
            Content="Use selected"
            Style="{ThemeResource AccentButtonStyle}"
            Click="UseLyricsButton_Click"
            IsEnabled="False" />
    </local:LyricsSearchDialogView.FooterContent>
  </local:LyricsSearchDialogView>
</UserControl>
