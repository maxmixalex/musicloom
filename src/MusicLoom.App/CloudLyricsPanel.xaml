<UserControl x:Class="MusicLoom.App.CloudLyricsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MusicLoom.App" MinWidth="760">
  <local:LyricsSearchDialogView x:Name="SearchLayout">
    <local:LyricsSearchDialogView.SearchContent>
      <StackPanel Spacing="10">
        <TextBox x:Name="ArtistBox" Header="Artist" />
        <TextBox x:Name="TitleBox" Header="Title" />
        <TextBox x:Name="AlbumBox" Header="Album" />
        <Button x:Name="AudioRecognizeButton"
                Content="Recognize from audio"
                Click="AudioRecognizeButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch" />
        <Button x:Name="SearchButton" Content="Search by metadata"
                Click="SearchButton_Click"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}" />
        <TextBlock x:Name="ProviderStatus"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </local:LyricsSearchDialogView.SearchContent>
    <local:LyricsSearchDialogView.CandidatesContent>
      <ListView x:Name="CandidatesList"
                  SelectionMode="Single"
                  SelectionChanged="CandidatesList_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <local:LyricsSearchCandidateCard
                  SongTitle="{Binding Title}"
                  ArtistName="{Binding Artist}"
                  AlbumName="{Binding Album}"
                  DurationText="{Binding Duration}"
                  ArtworkSource="{Binding Artwork}"
                  PreviewTooltip="{Binding PreviewTooltip}"
                  PreviewRequested="CandidateCard_PreviewRequested"/>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
    </local:LyricsSearchDialogView.CandidatesContent>
    <local:LyricsSearchDialogView.LyricsContent>
      <local:LyricsSearchPreviewView x:Name="LyricsPreview"/>
    </local:LyricsSearchDialogView.LyricsContent>
    <local:LyricsSearchDialogView.FooterContent>
      <Button x:Name="UseLyricsButton"
            HorizontalAlignment="Right"
            Content="Use selected"
            Style="{ThemeResource AccentButtonStyle}"
            Click="UseLyricsButton_Click"
            IsEnabled="False" />
    </local:LyricsSearchDialogView.FooterContent>
  </local:LyricsSearchDialogView>
</UserControl>
