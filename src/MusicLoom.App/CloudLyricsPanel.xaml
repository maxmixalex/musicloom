<UserControl x:Class="MusicLoom.App.CloudLyricsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MusicLoom.App"
  xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" MinWidth="760">
  <local:LyricsSearchDialogView x:Name="SearchLayout">
    <local:LyricsSearchDialogView.SearchContent>
      <local:LyricsSearchFormView x:Name="SearchInputs"/>
    </local:LyricsSearchDialogView.SearchContent>
    <local:LyricsSearchDialogView.CandidatesContent>
      <ListView x:Name="CandidatesList"
                  SelectionMode="Single"
                  SelectionChanged="CandidatesList_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  Padding="12,0,22,0"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="6,1,12,1" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <!-- Restore NetEase-like native selection indicator. The
                   candidate itself remains the same shared XAML control. -->
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListViewItem">
                    <primitives:ListViewItemPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        SelectionIndicatorVisualEnabled="True"
                        SelectionIndicatorMode="Inline"
                        SelectionIndicatorBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        SelectionIndicatorPointerOverBrush="{ThemeResource AccentFillColorSecondaryBrush}"
                        SelectionIndicatorPressedBrush="{ThemeResource AccentFillColorTertiaryBrush}"/>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate>
              <local:LyricsSearchCandidateCard
                  SongTitle="{Binding Title}"
                  ArtistName="{Binding Artist}"
                  AlbumName="{Binding Album}"
                  DurationText="{Binding DisplayMetadata}"
                  ArtworkSource="{Binding Artwork}"
                  PreviewTooltip="{Binding PreviewTooltip}"
                  IsPreviewPlaying="{Binding PreviewIsPlaying, Mode=OneWay}"
                  ExternalUrl="{Binding ExternalUrl}"
                  ExternalLabel="{Binding ExternalLabel}"
                  PreviewRequested="CandidateCard_PreviewRequested"/>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
    </local:LyricsSearchDialogView.CandidatesContent>
    <local:LyricsSearchDialogView.LyricsContent>
      <local:LyricsSearchPreviewView x:Name="LyricsPreview"/>
    </local:LyricsSearchDialogView.LyricsContent>
    <local:LyricsSearchDialogView.FooterContent>
      <Button x:Name="UseMatchButton"
            HorizontalAlignment="Right"
            Content="Use selected"
            Style="{ThemeResource AccentButtonStyle}"
            Click="UseMatchButton_Click"
            IsEnabled="False" />
    </local:LyricsSearchDialogView.FooterContent>
  </local:LyricsSearchDialogView>
</UserControl>
