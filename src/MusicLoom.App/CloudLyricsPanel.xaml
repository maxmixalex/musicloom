<UserControl x:Class="MusicLoom.App.CloudLyricsPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MusicLoom.App" MinWidth="760">
  <local:LyricsSearchDialogView x:Name="SearchLayout">
    <local:LyricsSearchDialogView.SearchContent>
      <local:LyricsSearchFormView x:Name="SearchInputs"/>
    </local:LyricsSearchDialogView.SearchContent>
    <local:LyricsSearchDialogView.CandidatesContent>
      <ListView x:Name="CandidatesList"
                  SelectionMode="Single"
                  SelectionChanged="CandidatesList_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <local:LyricsSearchCandidateCard
                  SongTitle="{Binding Title}"
                  ArtistName="{Binding Artist}"
                  AlbumName="{Binding Album}"
                  DurationText="{Binding Duration}"
                  ArtworkSource="{Binding Artwork}"
                  PreviewTooltip="{Binding PreviewTooltip}"
                  PreviewRequested="CandidateCard_PreviewRequested"/>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
    </local:LyricsSearchDialogView.CandidatesContent>
    <local:LyricsSearchDialogView.LyricsContent>
      <local:LyricsSearchPreviewView x:Name="LyricsPreview"/>
    </local:LyricsSearchDialogView.LyricsContent>
    <local:LyricsSearchDialogView.FooterContent>
      <Button x:Name="UseLyricsButton"
            HorizontalAlignment="Right"
            Content="Use selected"
            Style="{ThemeResource AccentButtonStyle}"
            Click="UseLyricsButton_Click"
            IsEnabled="False" />
    </local:LyricsSearchDialogView.FooterContent>
  </local:LyricsSearchDialogView>
</UserControl>
