<UserControl x:Class="MusicLoom.App.CloudLyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLoom.App">
  <local:LyricsSearchDialogView x:Name="SearchLayout">
    <local:LyricsSearchDialogView.SearchContent>
      <StackPanel Spacing="10">
        <TextBox x:Name="ArtistBox" Header="Artist" />
        <TextBox x:Name="TitleBox" Header="Title" />
        <TextBox x:Name="AlbumBox" Header="Album" />
        <Button x:Name="AudioRecognizeButton" Content="Recognize from audio"
                Click="AudioRecognizeButton_Click" HorizontalAlignment="Stretch"
                Visibility="Collapsed" />
        <Button x:Name="SearchButton" Content="Search by metadata"
                Click="SearchButton_Click" HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}" />
        <TextBlock x:Name="ProviderStatus" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </local:LyricsSearchDialogView.SearchContent>
    <local:LyricsSearchDialogView.CandidatesContent>
      <ListView x:Name="CandidatesList" SelectionMode="Single"
                SelectionChanged="CandidatesList_SelectionChanged"
                HorizontalContentAlignment="Stretch">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="10,10" MinHeight="72" ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="6"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <FontIcon Glyph="&#xE8D6;" FontSize="18"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Album}" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </local:LyricsSearchDialogView.CandidatesContent>
    <local:LyricsSearchDialogView.LyricsContent>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="LyricsPreview" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </ScrollViewer>
    </local:LyricsSearchDialogView.LyricsContent>
    <local:LyricsSearchDialogView.FooterContent>
      <Button x:Name="UseLyricsButton" Content="Use selected"
              Click="UseLyricsButton_Click" IsEnabled="False"
              Style="{StaticResource AccentButtonStyle}" />
    </local:LyricsSearchDialogView.FooterContent>
  </local:LyricsSearchDialogView>
</UserControl>
