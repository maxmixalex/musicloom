<UserControl
    x:Class="MusicLoom.App.CloudLyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLoom.App"
    MinWidth="760">
  <!-- Same three-column search / candidates / lyrics preview shell as
       NetEase's in-app matching dialog. Never open a separate OS window. -->
  <Grid ColumnSpacing="12" RowSpacing="10" Padding="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2.5*" MinWidth="190" />
      <ColumnDefinition Width="4.2*" MinWidth="285" />
      <ColumnDefinition Width="3.3*" MinWidth="245" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Padding="12" CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <StackPanel Spacing="10">
        <TextBlock x:Name="SearchHeading" Text="Search"
                   FontSize="18" FontWeight="SemiBold" />
        <TextBox x:Name="ArtistBox" Header="Artist" />
        <TextBox x:Name="TitleBox" Header="Title" />
        <TextBox x:Name="AlbumBox" Header="Album" />
        <Button x:Name="AudioRecognizeButton"
                Content="Recognize from audio"
                Click="AudioRecognizeButton_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch" />
        <Button x:Name="SearchButton" Content="Search by metadata"
                Click="SearchButton_Click"
                HorizontalAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}" />
        <TextBlock x:Name="ProviderStatus"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Padding="12" CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="CandidatesHeading"
                   Text="Candidates" FontSize="18"
                   FontWeight="SemiBold" />
        <ListView x:Name="CandidatesList" Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="CandidatesList_SelectionChanged"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid Margin="3,3,6,3" Padding="9" ColumnSpacing="12"
                    MinHeight="68">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="7"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                  <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="18"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image Source="{Binding Artwork}"
                           Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Artist}"
                             FontSize="12"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Album}"
                             FontSize="11"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Duration}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <Border Grid.Column="2" Padding="12" CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="LyricsHeading"
                   Text="Lyrics" FontSize="18" FontWeight="SemiBold" />
        <ListView x:Name="LyricsPreview" Grid.Row="1"
                  SelectionMode="None"
                  DoubleTapped="LyricsPreview_DoubleTapped"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="4,8" Spacing="4">
                <TextBlock Text="{Binding TimestampText}" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock local:KaraokeLyricText.Line="{Binding}"
                           TextWrapping="WrapWholeWords"
                           FontSize="16" />
                <TextBlock local:KaraokeLyricText.Line="{Binding}"
                           local:KaraokeLyricText.IsSecondary="True"
                           Visibility="{Binding SecondaryVisibility}"
                           TextWrapping="WrapWholeWords"
                           FontSize="13"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
    <Button x:Name="UseLyricsButton" Grid.Row="1" Grid.ColumnSpan="3"
            HorizontalAlignment="Right"
            Content="Use selected"
            Style="{ThemeResource AccentButtonStyle}"
            Click="UseLyricsButton_Click"
            IsEnabled="False" />
  </Grid>
</UserControl>
