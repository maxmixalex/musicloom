<UserControl x:Class="MusicLoom.App.ImmersivePlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLoom.App"
    IsTabStop="True" KeyDown="ImmersivePlayer_KeyDown">
  <Grid Padding="48,26,48,38">
    <Grid.Background>
      <LinearGradientBrush x:Name="ArtworkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#244B67" Offset="0" />
        <GradientStop Color="#172D45" Offset="0.54" />
        <GradientStop Color="#0D1625" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <!-- The tint is decorative only and follows the artwork palette. -->
    <Ellipse x:Name="PaletteGlow" Grid.RowSpan="2"
             Width="880" Height="880" Margin="-360,-360,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             IsHitTestVisible="False" Opacity="0.14"
             Fill="#607EA8" />
    <Grid Grid.Row="0" ColumnSpacing="20" Margin="0,0,0,26">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Border x:Name="BrandAccent" Width="4" Height="21" CornerRadius="2" Background="#8CBADF" />
        <TextBlock Text="MusicLoom" FontSize="17" FontWeight="SemiBold"
                   Foreground="White" VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="ExitButton" Grid.Column="1" Height="38" Padding="14,0"
              Background="#22FFFFFF" BorderBrush="#33FFFFFF"
              Click="ExitButton_Click" ToolTipService.ToolTip="Exit fullscreen">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <FontIcon Glyph="&#xE8A7;" FontSize="15" Foreground="White" />
          <TextBlock x:Name="ExitButtonLabel" Text="Exit fullscreen"
                     Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="72" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4.6*" MinWidth="260" />
        <ColumnDefinition Width="5.4*" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" MaxWidth="470" RowSpacing="26" VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="6" CornerRadius="13"
                BorderBrush="#36FFFFFF" BorderThickness="1"
                Background="#0DFFFFFF">
          <Border CornerRadius="9" Background="#22000000">
            <Image x:Name="AlbumCover" Stretch="Uniform" MaxHeight="470" MaxWidth="470" />
          </Border>
        </Border>
        <Grid Grid.Row="1" RowSpacing="4">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Slider x:Name="ProgressSlider" Grid.Row="0" Minimum="0" Maximum="1"
                  ValueChanged="ProgressSlider_ValueChanged" />
          <TextBlock x:Name="PlaybackTime" Grid.Row="1"
                     Foreground="#CCFFFFFF" FontSize="12" Text="0:00 / 0:00"
                     HorizontalAlignment="Right" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="20">
          <Button Width="44" Height="44" Padding="0" Click="PreviousButton_Click"
                  Background="Transparent" BorderBrush="#42FFFFFF">
            <FontIcon Glyph="&#xE892;" FontSize="17" Foreground="White" />
          </Button>
          <Button x:Name="PlayPauseButton" Width="54" Height="54" Padding="0"
                  Click="PlayPauseButton_Click"
                  Background="#BCDDF5" BorderBrush="Transparent">
            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" Foreground="#182A3C" />
          </Button>
          <Button Width="44" Height="44" Padding="0" Click="NextButton_Click"
                  Background="Transparent" BorderBrush="#42FFFFFF">
            <FontIcon Glyph="&#xE893;" FontSize="17" Foreground="White" />
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" RowSpacing="25" VerticalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock x:Name="TrackHeading" Text="Nothing playing"
                       FontSize="30" FontWeight="SemiBold"
                       Foreground="White" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AlbumHeading" Foreground="#C4FFFFFF"
                       FontSize="15" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ComboBox x:Name="LyricModeBox" Grid.Column="1" MinWidth="140"
                    VerticalAlignment="Top" Background="#20FFFFFF"
                    BorderBrush="#52FFFFFF" Foreground="White"
                    SelectionChanged="LyricModeBox_SelectionChanged">
            <ComboBoxItem x:Name="OriginalOnlyChoice" Tag="originalOnly" Content="Original only" />
            <ComboBoxItem x:Name="PreferTranslationChoice" Tag="preferTranslation" Content="Prefer translation" />
            <ComboBoxItem x:Name="PreferOriginalChoice" Tag="preferOriginal" Content="Prefer original" />
          </ComboBox>
        </Grid>
        <ListView x:Name="ImmersiveLyricsList" Grid.Row="1"
                  SelectionMode="None" Background="Transparent"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="1,12" Spacing="6" Opacity="{Binding ImmersiveOpacity}">
                <TextBlock x:Name="PrimaryLyricText"
                           local:KaraokeLyricText.Line="{Binding}"
                           FontSize="{Binding ImmersiveFontSize}" FontWeight="SemiBold"
                           Foreground="White" TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="SecondaryLyricText"
                           local:KaraokeLyricText.Line="{Binding}"
                           local:KaraokeLyricText.IsSecondary="True"
                           Visibility="{Binding SecondaryVisibility}"
                           FontSize="16" Foreground="#C8FFFFFF"
                           TextWrapping="WrapWholeWords" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
