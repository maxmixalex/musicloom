<UserControl
    x:Class="MusicLoom.App.ImmersivePlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLoom.App"
    IsTabStop="True"
    KeyDown="ImmersivePlayer_KeyDown">
  <Grid Padding="42,24,42,32">
    <Grid.Background>
      <LinearGradientBrush x:Name="ArtworkGradient"
                           StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#386C8A" Offset="0" />
        <GradientStop Color="#2B5575" Offset="0.52" />
        <GradientStop Color="#183A55" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Button x:Name="ExitButton" Grid.Row="0" Width="40" Height="40"
            HorizontalAlignment="Right" Padding="0"
            Background="#25FFFFFF" BorderBrush="#50FFFFFF"
            Click="ExitButton_Click" ToolTipService.ToolTip="Exit fullscreen">
      <FontIcon Glyph="&#xE8A7;" FontSize="17" Foreground="White" />
    </Button>

    <Grid Grid.Row="1" ColumnSpacing="54" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="260" />
        <ColumnDefinition Width="6*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- Left: generous cover, padded and softly elevated like the reference. -->
      <Grid Grid.Column="0" MaxWidth="550" RowSpacing="21"
            VerticalAlignment="Center">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="11" CornerRadius="22"
                Background="#2CFFFFFF" BorderBrush="#52FFFFFF"
                BorderThickness="1" Translation="0,0,15">
          <Border.Shadow>
            <ThemeShadow />
          </Border.Shadow>
          <Border CornerRadius="13" Background="#25000000">
            <Image x:Name="AlbumCover" Stretch="Uniform" />
          </Border>
        </Border>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Slider x:Name="ProgressSlider" Grid.Row="0"
                  Minimum="0" Maximum="1"
                  ValueChanged="ProgressSlider_ValueChanged" />
          <TextBlock x:Name="PlaybackTime" Grid.Row="1"
                     Foreground="#D9FFFFFF"
                     HorizontalAlignment="Right"
                     FontSize="12" Text="0:00 / 0:00" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="15">
          <Button Width="44" Height="44" Padding="0"
                  Click="PreviousButton_Click"
                  Background="#24FFFFFF" BorderBrush="#44FFFFFF">
            <FontIcon Glyph="&#xE892;" FontSize="17" Foreground="White" />
          </Button>
          <Button Width="52" Height="52" Padding="0"
                  Click="PlayPauseButton_Click"
                  Background="#38FFFFFF" BorderBrush="#70FFFFFF">
            <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play"
                        Foreground="White" />
          </Button>
          <Button Width="44" Height="44" Padding="0"
                  Click="NextButton_Click"
                  Background="#24FFFFFF" BorderBrush="#44FFFFFF">
            <FontIcon Glyph="&#xE893;" FontSize="17" Foreground="White" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Right: heading and lyrics. No duplicated audio player state. -->
      <Grid Grid.Column="1" VerticalAlignment="Stretch" RowSpacing="18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock x:Name="TrackHeading" Text="Nothing playing"
                       FontSize="24" FontWeight="SemiBold"
                       Foreground="White" MaxLines="2"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AlbumHeading" Text=""
                       Foreground="#BFFFFFFF"
                       FontSize="15" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ComboBox x:Name="LyricModeBox" Grid.Column="1"
                    MinWidth="140" VerticalAlignment="Top"
                    Background="#25FFFFFF" BorderBrush="#64FFFFFF"
                    Foreground="White"
                    SelectionChanged="LyricModeBox_SelectionChanged">
            <ComboBoxItem x:Name="OriginalOnlyChoice" Tag="originalOnly" Content="Original only" />
            <ComboBoxItem x:Name="PreferTranslationChoice" Tag="preferTranslation" Content="Prefer translation" />
            <ComboBoxItem x:Name="PreferOriginalChoice" Tag="preferOriginal" Content="Prefer original" />
          </ComboBox>
        </Grid>
        <ListView x:Name="ImmersiveLyricsList" Grid.Row="1"
                  SelectionMode="None" Background="Transparent"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Padding="1,10" Spacing="7"
                          Opacity="{Binding ImmersiveOpacity}">
                <TextBlock x:Name="PrimaryLyricText"
                           local:KaraokeLyricText.Line="{Binding}"
                           FontSize="{Binding ImmersiveFontSize}"
                           FontWeight="SemiBold" Foreground="White"
                           TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="SecondaryLyricText"
                           local:KaraokeLyricText.Line="{Binding}"
                           local:KaraokeLyricText.IsSecondary="True"
                           Visibility="{Binding SecondaryVisibility}"
                           FontSize="16" Foreground="#CBFFFFFF"
                           TextWrapping="WrapWholeWords" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
