<UserControl
    x:Class="MusicLoom.App.LyricsSearchPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MusicLoom.App">
  <!-- MainWindow supplies the actual LyricsList ItemTemplate and style at
       runtime for all three providers. This matching fallback preserves
       the original timestamp-left, karaoke, two-line lyric geometry. -->
  <ListView x:Name="PreviewList"
            SelectionMode="Single"
            IsItemClickEnabled="False"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            DoubleTapped="PreviewList_DoubleTapped"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListView.ItemTemplate>
      <DataTemplate>
        <Grid Padding="8,7" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding TimestampText}"
                     Margin="0,3,0,0" FontSize="11"
                     VerticalAlignment="Top"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock local:KaraokeLyricText.Line="{Binding}"
                       FontSize="{Binding PrimaryFontSize}"
                       LineHeight="23" TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock local:KaraokeLyricText.Line="{Binding}"
                       local:KaraokeLyricText.IsSecondary="True"
                       Visibility="{Binding SecondaryVisibility}"
                       FontSize="{Binding SecondaryFontSize}"
                       LineHeight="20" TextWrapping="WrapWholeWords"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>
</UserControl>
